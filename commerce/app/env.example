# Documentation only. Set credentials outside Git in the local process or Cloudflare secrets.
MODE=sandbox
OPERATOR_EMAIL=kontakt@aeternus-verlag.de
# Required secrets: ADMIN_TOKEN (32+ chars), STRIPE_KEY (sk_test_), STRIPE_WEBHOOK_SECRET,
# LULU_CLIENT_KEY, LULU_CLIENT_SECRET
# Local preview defaults to simulation with an ephemeral administrative token.
# Sandbox quotations are blocked until catalog approvals and reviewed pricing exist.
TAX_POLICY_APPROVED=false
MIN_MARGIN_CENTS=100
# Required numeric policy per currency/country, deliberately unset:
# SHIPPING_GROSS_EUR, SHIPPING_GROSS_USD, SHIPPING_GROSS_GBP, SHIPPING_GROSS_CAD, SHIPPING_GROSS_AUD
# RETAIL_TAX_BPS_DE, RETAIL_TAX_BPS_US, RETAIL_TAX_BPS_GB, RETAIL_TAX_BPS_CA, RETAIL_TAX_BPS_AU
# A single country rate is insufficient for US/CA subregions: keep these destinations blocked
# until destination-specific tax calculation is implemented and legally reviewed.
# PAYMENT_FEE_BPS, PAYMENT_FEE_FIXED_EUR, PAYMENT_FEE_FIXED_USD, PAYMENT_FEE_FIXED_GBP,
# PAYMENT_FEE_FIXED_CAD, PAYMENT_FEE_FIXED_AUD
# Cloud deployment requires: ACCESS_ISSUER, ACCESS_AUDIENCE, PRIVATE_DEPLOYMENT_VERIFIED.
