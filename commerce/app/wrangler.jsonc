{
  "name": "aeternus-commerce-sandbox",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../dist/shop-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "MODE": "sandbox",
    "OPERATOR_EMAIL": "kontakt@aeternus-verlag.de",
    "ACCESS_ALLOWED_EMAILS": "kontakt@aeternus-verlag.de",
    "PRIVATE_DEPLOYMENT_VERIFIED": "true",
    "ACCESS_ISSUER": "https://quiet-meadow-ff04.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "622ab0cad19679f7165a9d7cd1b4d8f03704b661e52169762a498ed606a3d1cf"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aeternus-commerce-sandbox",
      "database_id": "a6123bd1-c68e-4c37-b989-5125d2575306",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "sandbox-shop.aeternuspublishing.com",
      "custom_domain": true
    }
  ]
}
