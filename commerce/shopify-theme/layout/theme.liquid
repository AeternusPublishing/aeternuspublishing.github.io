<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title | escape }} · AETERNUS</title>
  <meta name="description" content="{{ page_description | escape }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {% unless settings.commerce_enabled %}<meta name="robots" content="noindex,nofollow">{% endunless %}
  {{ 'aeternus.css' | asset_url | stylesheet_tag }}
  {% style %}@font-face{font-family:Fraunces;src:url({{ 'fraunces-extended.woff2' | asset_url }}) format('woff2');font-weight:300 600;font-display:swap;unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;}{% endstyle %}
  {{ content_for_header }}
</head>
<body>
<a class="skip" href="#main">{{ 'general.skip' | t }}</a>
{% unless settings.commerce_enabled %}<div class="preview">{{ 'general.preview' | t }}</div>{% endunless %}
<header><div class="shell header"><a class="brand" href="{{ routes.root_url }}"><img src="{{ 'aeternus-wordmark.svg' | asset_url }}" width="250" height="40" alt="AETERNUS"><span>PUBLISHING</span></a><nav aria-label="{{ 'general.navigation' | t }}"><a href="{{ routes.all_products_collection_url }}">{{ 'general.books' | t }}</a><a href="{% if request.locale.iso_code == 'de' %}{{ settings.publisher_de }}{% else %}{{ settings.publisher_en }}{% endif %}">{{ 'general.publisher' | t }} ↗</a><a href="{{ routes.cart_url }}">{{ 'cart.title' | t }} ({{ cart.item_count }})</a></nav></div></header>
<main id="main" class="shell">{{ content_for_layout }}</main>
<footer class="shell"><p>AETERNUS PUBLISHING</p><p><a href="https://aeternuspublishing.com/why-aeternus/">Why AETERNUS?</a> · <a href="https://www.instagram.com/{% if request.locale.iso_code == 'de' %}aeternus.verlag{% else %}aeternus.publishing{% endif %}/" target="_blank" rel="noopener noreferrer">Instagram ↗</a></p>{% render 'localization' %}<p><a href="mailto:kontakt@aeternus-verlag.de">kontakt@aeternus-verlag.de</a></p>{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a> {% endif %}{% endfor %}</footer>
</body></html>
