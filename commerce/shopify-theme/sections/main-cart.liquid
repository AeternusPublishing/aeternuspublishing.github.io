<h1>{{ 'cart.title' | t }}</h1>{% if cart.item_count == 0 %}<p>{{ 'cart.empty' | t }}</p><a href="{{ routes.all_products_collection_url }}">{{ 'general.books' | t }}</a>{% else %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<article class="cart-row"><a href="{{ item.url }}">{{ item.product.title | escape }} — {{ item.variant.title | escape }}</a><label for="Quantity-{{ item.key }}">{{ 'product.quantity' | t }}</label><input id="Quantity-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"><span>{{ item.final_line_price | money_with_currency }}</span><a href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a></article>{% endfor %}<p>{{ 'cart.total' | t }}: {{ cart.total_price | money_with_currency }}</p><p>{{ 'cart.taxes' | t }}</p><button name="update" type="submit">{{ 'cart.update' | t }}</button>{% if settings.commerce_enabled %}<button name="checkout" type="submit">{{ 'cart.checkout' | t }}</button>{% else %}<p>{{ 'general.forthcoming' | t }}</p>{% endif %}</form>{% endif %}
{% schema %}{"name":"Cart","settings":[]}{% endschema %}
