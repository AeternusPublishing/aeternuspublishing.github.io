<section class="product"><div>{% for image in product.images %}{{ image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,1000', sizes: '(min-width: 800px) 40vw, 90vw' }}{% endfor %}</div><div><p class="eyebrow">{{ product.vendor | escape }}</p><h1>{{ product.title | escape }}</h1><div class="rte">{{ product.description }}</div>
{% if settings.commerce_enabled %}
{% form 'product', product %}<label for="Variant-{{ section.id }}">{{ 'product.format' | t }}</label><select name="id" id="Variant-{{ section.id }}">{% for variant in product.variants %}<option value="{{ variant.id }}"{% if variant == product.selected_or_first_available_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money_with_currency }}{% unless variant.available %} · {{ 'product.sold_out' | t }}{% endunless %}</option>{% endfor %}</select><label for="Quantity-{{ section.id }}">{{ 'product.quantity' | t }}</label><input type="number" id="Quantity-{{ section.id }}" name="quantity" min="1" value="1"><button type="submit" name="add"{% unless product.available %} disabled{% endunless %}>{{ 'product.add' | t }}</button>{{ form.errors | default_errors }}{% endform %}
<script type="application/ld+json">{{ product | structured_data }}</script>
{% else %}<p class="notice">{{ 'general.forthcoming' | t }}</p>{% endif %}
<nav class="edition-links" aria-label="{{ 'product.edition' | t }}">{% if product.metafields.aeternus.author_url.value %}<a href="{{ product.metafields.aeternus.author_url.value | escape }}">{{ 'product.author' | t }}</a>{% endif %}{% if product.metafields.aeternus.series_url.value %}<a href="{{ product.metafields.aeternus.series_url.value | escape }}">{{ 'product.series' | t }}</a>{% endif %}{% if product.metafields.aeternus.edition_url.value %}<a href="{{ product.metafields.aeternus.edition_url.value | escape }}">{{ 'product.edition' | t }}</a>{% endif %}{% if product.metafields.aeternus.sample_url.value %}<a href="{{ product.metafields.aeternus.sample_url.value | escape }}">{{ 'product.sample' | t }}</a>{% endif %}</nav></div></section>
{% schema %}{"name":"Book edition","settings":[]}{% endschema %}
