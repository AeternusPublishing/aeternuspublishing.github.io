<section class="hero"><h1>{{ 'password.title' | t }}</h1><p>{{ 'password.message' | t }}</p>{% form 'storefront_password' %}{{ form.errors | default_errors }}<label for="Password">{{ 'password.label' | t }}</label><input type="password" id="Password" name="password" autocomplete="current-password"><button type="submit">{{ 'password.enter' | t }}</button>{% endform %}</section>
