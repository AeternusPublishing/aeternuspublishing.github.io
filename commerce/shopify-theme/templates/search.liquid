<h1>{{ 'search.title' | t }}</h1><form action="{{ routes.search_url }}" method="get"><label for="Search">{{ 'search.title' | t }}</label><input id="Search" type="search" name="q" value="{{ search.terms | escape }}"><input type="hidden" name="type" value="product"><button>{{ 'search.submit' | t }}</button></form>{% if search.performed %}{% paginate search.results by 24 %}<div class="grid">{% for product in search.results %}{% render 'book-card', product: product %}{% else %}<p>{{ 'search.empty' | t }}</p>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}{% endif %}
