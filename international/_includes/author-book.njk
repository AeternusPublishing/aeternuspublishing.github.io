<article class="author-book">
  <a class="book-art" href="{{ item.url }}">
    {% set cover = item.cover | existingImage %}
    {% if cover %}
      <picture>{% if item.coverWebp %}<source type="image/webp" srcset="{{ item.coverWebp }}">{% endif %}<img src="{{ cover }}" alt="{{ item.title | escape }}" width="400" height="600" loading="lazy"></picture>
    {% else %}<span class="type-cover"><small>AETERNUS</small><strong>{{ item.title }}</strong><span>{{ item.authorName }}</span></span>{% endif %}
  </a>
  <div class="author-book-copy">
    <p class="kicker">{{ item.seriesName }}</p>
    <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
    <p>{{ item.description.short }}</p>
    {% if item.cardStatus %}<p class="edition-note">{{ item.cardStatus }}</p>{% endif %}
    <a class="text-link" href="{{ item.url }}">Explore the edition <span aria-hidden="true">→</span></a>
  </div>
</article>
