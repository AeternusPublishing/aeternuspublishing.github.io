<article class="book-tile"><a class="book-art" href="{{ item.url }}">{% set cover = item.cover | existingImage %}{% if cover %}<img src="{{ cover }}" alt="{{ item.title | escape }}" width="400" height="600" loading="lazy">{% else %}<span class="type-cover"><small>AETERNUS</small><strong>{{ item.title }}</strong><span>{{ item.authorName }}</span></span>{% endif %}<span class="art-arrow" aria-hidden="true">↗</span></a><div class="book-caption"><p class="kicker"><span class="series-dot" style="--series-color:{{ item.seriesColor }}"></span>{{ item.seriesName }}</p><p class="book-author"><a href="{{ item.authorUrl }}">{{ item.authorName }}</a></p><h3 class="book-card-title"><a href="{{ item.url }}">{{ item.title }}</a></h3><p class="book-description">{{ item.description.short }}</p><a class="text-link" href="{{ item.url }}">Explore the edition →</a></div></article>
