<div class="cl-covers">{% for b in coverBooks %}{% if loop.index <= coverMax %}{% set cover = b.cover | existingImage %}{% if cover %}<a href="{{ b.url }}" tabindex="-1" aria-hidden="true"><img src="{{ cover | thumb(240) }}" alt="" width="120" height="180" loading="lazy" decoding="async"></a>{% endif %}{% endif %}{% endfor %}{% if coverBooks.length > coverMax %}<span class="cl-more">+ {{ coverBooks.length - coverMax }} more</span>{% endif %}</div>
