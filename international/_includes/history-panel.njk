<article class="history-panel" aria-labelledby="theme-{{ theme.id }}"><p class="history-period">{{ theme.period }}</p><h2 id="theme-{{ theme.id }}"><a href="{{ theme.url }}">{{ theme.title }}</a></h2><p class="history-subtitle">{{ theme.subtitle }}</p><p>{{ theme.body[0] }}</p>{% if theme.books.length %}<p class="history-count">{{ theme.books.length }} {% if theme.books.length == 1 %}{% if history.lang == 'de' %}Ausgabe im Sprachkatalog{% else %}edition in this language catalogue{% endif %}{% else %}{{ history.labels.count }}{% endif %}</p>{% endif %}<a class="history-link" href="{{ theme.url }}">{{ history.labels.read }} <span aria-hidden="true">→</span></a></article>
