<meta property="og:type" content="{% if book %}book{% else %}website{% endif %}"><meta property="og:title" content="{{ title | escape }} · {% if author.slug == "william-gilmore-simms" or book.work_id == "WGS_001" or author.slug == "grey-owl" or author.slug == "napoleon-augustus-jennings" or book.author == "grey-owl" or book.work_id == "NAJ_001" %}AETERNUS{% else %}{{ site.name }}{% endif %}"><meta property="og:description" content="{{ description | escape }}"><meta property="og:url" content="{{ site.origin }}{{ page.url }}"><meta property="og:site_name" content="{% if author.slug == "william-gilmore-simms" or book.work_id == "WGS_001" or author.slug == "grey-owl" or author.slug == "napoleon-augustus-jennings" or book.author == "grey-owl" or book.work_id == "NAJ_001" %}AETERNUS{% else %}{{ site.name }}{% endif %}"><meta property="og:locale" content="{{ ogLocale or 'en_GB' }}"><meta property="og:image" content="{{ site.origin }}{% if author.slug == "napoleon-augustus-jennings" or book.work_id == "NAJ_001" %}/assets/images/cover-a-texas-ranger-jennings-en-20261009-fallback.jpg{% elif author.slug == "grey-owl" or book.author == "grey-owl" %}/assets/images/cover-men-of-the-last-frontier-grey-owl-en-20261008.jpg{% elif author.slug == "william-gilmore-simms" or book.work_id == "WGS_001" %}/assets/images/cover-wgs001-en-v6-20261008.jpg{% else %}/assets/images/hero-library.jpg{% endif %}"><meta name="twitter:card" content="summary_large_image">
