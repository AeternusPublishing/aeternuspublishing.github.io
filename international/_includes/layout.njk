{% if timelinePage %}<link rel="alternate" hreflang="de" href="https://aeternus-verlag.de/reihen/gruen/zeittafel/"><link rel="alternate" hreflang="en" href="https://aeternuspublishing.com/series/gruen/chronology/"><link rel="alternate" hreflang="x-default" href="https://aeternuspublishing.com/series/gruen/chronology/">{% endif %}
