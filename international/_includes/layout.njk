<link rel="stylesheet" href="/assets/css/details.css?v=20260922-portraits"><script src="/assets/js/international.js" defer></script>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"{% if author.slug == "william-gilmore-simms" or book.work_id == "WGS_001" or author.slug == "grey-owl" or author.slug == "napoleon-augustus-jennings" or book.author == "grey-owl" or book.work_id == "NAJ_001" %}AETERNUS{% else %}AETERNUS PUBLISHING{% endif %}","url":"https://aeternuspublishing.com","sameAs":["https://www.instagram.com/aeternus.publishing/"]}</script>
