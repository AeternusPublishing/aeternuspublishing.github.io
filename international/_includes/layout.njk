<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title | escape }} · {{ site.name }}</title>
<meta name="description" content="{{ description | escape }}">
<meta name="robots" content="noindex, nofollow"><meta name="theme-color" content="#171816">
<link rel="canonical" href="{{ site.origin }}{{ page.url }}">
<meta property="og:type" content="{% if book %}book{% else %}website{% endif %}"><meta property="og:title" content="{{ title | escape }} · {{ site.name }}"><meta property="og:description" content="{{ description | escape }}"><meta property="og:url" content="{{ site.origin }}{{ page.url }}"><meta property="og:site_name" content="{{ site.name }}"><meta property="og:locale" content="en_GB"><meta property="og:image" content="{{ site.origin }}/assets/images/hero-library.jpg"><meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="/assets/css/fonts.css"><link rel="stylesheet" href="/assets/css/editorial.css"><link rel="stylesheet" href="/assets/css/international.css">
{% if book %}<script type="application/ld+json">{{ book | bookSchema | jsonld | safe }}</script>{% set product = book | productSchema %}{% if product %}<script type="application/ld+json">{{ product | jsonld | safe }}</script>{% endif %}{% endif %}
<link rel="stylesheet" href="/assets/css/details.css"><script src="/assets/js/international.js" defer></script>
</head><body class="editorial-site international-site">
<a class="skip-link" href="#main">Skip to content</a>
<div class="preview-strip">INTERNATIONAL PREVIEW <span>·</span> Direct shop forthcoming</div>
<header class="masthead"><div class="shell masthead-inner">
<a class="international-brand" href="/" aria-label="AETERNUS PUBLISHING — home"><img src="/assets/images/aeternus-wordmark.svg" alt="AETERNUS" width="832" height="50"><span>PUBLISHING</span></a>
<button class="menu-toggle" aria-expanded="false" aria-controls="main-navigation" hidden>Menu <span aria-hidden="true">☰</span></button>
<nav class="main-navigation" id="main-navigation" aria-label="Main navigation">{% for label, url in site.nav %}<a href="{{ url }}"{% if page.url == url %} aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}<a class="language-links" href="https://aeternus-verlag.de/" lang="de">DE ↗</a></nav></div></header>
<main id="main">{{ content | safe }}</main>
<footer class="colophon"><div class="shell footer-top"><div><a class="international-brand" href="/"><img src="/assets/images/aeternus-wordmark.svg" alt="AETERNUS" width="832" height="50" loading="lazy"><span>PUBLISHING</span></a><p>Historical voices.<br>Independent editions.</p></div><div><h2>Explore</h2>{% for label, url in site.nav %}<a href="{{ url }}">{{ label }}</a>{% endfor %}</div><div><h2>The publishing house</h2>{% for label, url in site.footer %}<a href="{{ url }}">{{ label }}</a>{% endfor %}</div></div><div class="shell footer-bottom"><span>© AETERNUS PUBLISHING</span><a href="mailto:{{ site.email }}">{{ site.email }}</a></div></footer>
</body></html>
