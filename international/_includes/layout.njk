<a class="international-brand" href="/" aria-label="{% if author.slug == "william-gilmore-simms" or book.work_id == "WGS_001" or author.slug == "grey-owl" or author.slug == "napoleon-augustus-jennings" or book.author == "grey-owl" or book.work_id == "NAJ_001" %}AETERNUS{% else %}AETERNUS PUBLISHING{% endif %} — home"><img src="/assets/images/aeternus-wordmark.svg" alt="AETERNUS" width="832" height="50">{% if author.slug != "william-gilmore-simms" and book.work_id != "WGS_001" and author.slug != "grey-owl" and author.slug != "napoleon-augustus-jennings" and book.author != "grey-owl" and book.work_id != "NAJ_001" %}<span>PUBLISHING</span>{% endif %}</a>
<button class="menu-toggle" aria-expanded="false" aria-controls="main-navigation" hidden>Menu <span aria-hidden="true">☰</span></button>
<nav class="main-navigation" id="main-navigation" aria-label="Main navigation">{% for label, url in site.nav %}{% if label != "Shop" or (author.slug != "napoleon-augustus-jennings" and book.work_id != "NAJ_001") %}<a href="{{ url }}"{% if page.url == url %} aria-current="page"{% endif %}>{{ label }}</a>{% endif %}{% endfor %}<a class="social-link" href="{{ site.social.instagram.url }}" target="_blank" rel="noopener noreferrer" aria-label="{% if author.slug == "napoleon-augustus-jennings" or book.work_id == "NAJ_001" %}AETERNUS{% else %}AETERNUS Publishing{% endif %} on Instagram (new tab)"><img src="/assets/images/instagram-official-gradient.png" width="22" height="22" alt="">Instagram ↗</a>{% if author.slug != "william-gilmore-simms" and book.work_id != "WGS_001" and author.slug != "grey-owl" and author.slug != "napoleon-augustus-jennings" and book.author != "grey-owl" and book.work_id != "NAJ_001" %}<a class="language-links" href="https://aeternus-verlag.de/" lang="de">DE ↗</a>{% endif %}</nav></div></header>
<main id="main">{{ content | safe }}</main>
<footer class="colophon"><div class="shell footer-top"><div><a class="international-brand" href="/"><img src="/assets/images/aeternus-wordmark.svg" alt="AETERNUS" width="832" height="50" loading="lazy">{% if author.slug != "william-gilmore-simms" and book.work_id != "WGS_001" and author.slug != "grey-owl" and author.slug != "napoleon-augustus-jennings" and book.author != "grey-owl" and book.work_id != "NAJ_001" %}<span>PUBLISHING</span>{% endif %}</a><p>Historical voices.<br>Independent editions.</p><a class="social-link" href="{{ site.social.instagram.url }}" target="_blank" rel="noopener noreferrer" aria-label="{% if author.slug == "napoleon-augustus-jennings" or book.work_id == "NAJ_001" %}AETERNUS{% else %}AETERNUS Publishing{% endif %} on Instagram (new tab)"><img src="/assets/images/instagram-official-gradient.png" width="22" height="22" alt="">Instagram ↗</a></div><div><h2>Explore</h2>{% for label, url in site.nav %}{% if label != "Shop" or (author.slug != "napoleon-augustus-jennings" and book.work_id != "NAJ_001") %}<a href="{{ url }}">{{ label }}</a>{% endif %}{% endfor %}</div><div><h2>The publishing house</h2>{% for label, url in site.footer %}<a href="{{ url }}">{{ label }}</a>{% endfor %}</div></div><div class="shell footer-bottom"><span>© {% if author.slug == "william-gilmore-simms" or book.work_id == "WGS_001" or author.slug == "grey-owl" or author.slug == "napoleon-augustus-jennings" or book.author == "grey-owl" or book.work_id == "NAJ_001" %}AETERNUS{% else %}AETERNUS PUBLISHING{% endif %}</span><a href="mailto:{{ site.email }}">{{ site.email }}</a></div></footer>
