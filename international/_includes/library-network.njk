<!doctype html><html lang="{{ library.lang }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ title }} · AETERNUS</title><meta name="description" content="{{ description }}"><meta property="og:title" content="{{ title }}"><meta property="og:description" content="{{ description }}"><meta property="og:type" content="website"><meta property="og:image" content="https://aeternus-verlag.de/assets/images/hero-library.jpg"><meta name="theme-color" content="#111714">
<link rel="canonical" href="{% if library.lang == 'de' %}https://aeternus-verlag.de/kosmos/netzwerk/{% else %}https://aeternuspublishing.com/book-universe/{% endif %}"><link rel="alternate" hreflang="de" href="https://aeternus-verlag.de/kosmos/netzwerk/"><link rel="alternate" hreflang="en" href="https://aeternuspublishing.com/book-universe/"><link rel="stylesheet" href="/assets/css/library-network.css?v=20260923-atlas2"></head><body>
{% set de = library.lang == 'de' %}
<main class="library-explorer" id="main">
<header class="atlas-header"><a class="atlas-brand" href="/">Ω AETERNUS<span>← {% if de %}Zum Verlag{% else %}The publishing house{% endif %}</span></a><div><p class="eyebrow">{% if de %}DER LITERARISCHE ATLAS{% else %}THE LITERARY ATLAS{% endif %}</p><h1>{% if de %}Eine Welt voller Bücher{% else %}A world of books{% endif %}</h1></div><a class="atlas-language" href="{% if de %}https://aeternuspublishing.com/book-universe/{% else %}https://aeternus-verlag.de/kosmos/netzwerk/{% endif %}">{% if de %}English{% else %}Deutsch{% endif %} ↗</a></header>
<div class="library-controls"><div class="view-switch"><button id="library-map" aria-pressed="true">{% if de %}Weltkarte{% else %}World map{% endif %}</button><button id="library-network" aria-pressed="false">{% if de %}Verbindungen{% else %}Connections{% endif %}</button></div><label class="search-label"><span class="sr-only">{{ library.ui.search }}</span><input id="library-search" type="search" placeholder="{{ library.ui.search }}" autocomplete="off"></label><label><span class="sr-only">{% if de %}Ausgabensprache{% else %}Edition language{% endif %}</span><select id="library-language"><option value="all">{{ library.ui.all }}</option><option value="de">{{ library.ui.de }}</option><option value="en">{{ library.ui.en }}</option></select></label><button id="library-reset">{% if de %}Alles entdecken{% else %}Explore everything{% endif %}</button></div>
<div class="library-workspace"><section class="library-canvas" aria-label="{{ library.ui.title }}"><svg id="library-graph" role="group" aria-label="{% if de %}Weltkarte mit Büchern und Verbindungen{% else %}World map of books and connections{% endif %}"></svg><nav class="atlas-regions" aria-label="Region"><button data-region="world" aria-pressed="true">{% if de %}Welt{% else %}World{% endif %}</button><button data-region="north-america">{% if de %}Nordamerika{% else %}North America{% endif %}</button><button data-region="europe">{% if de %}Europa{% else %}Europe{% endif %}</button><button data-region="africa">{% if de %}Afrika{% else %}Africa{% endif %}</button><button data-region="asia">{% if de %}Asien{% else %}Asia{% endif %}</button></nav><div class="atlas-zoom"><button id="library-zoom-in" aria-label="Zoom in">+</button><button id="library-zoom-out" aria-label="Zoom out">−</button></div><p id="library-status" role="status" aria-live="polite">{{ library.ui.hint }}</p><p class="atlas-invitation">{% if de %}Ein Buch auswählen. Seinen Verbindungen folgen.{% else %}Choose a book. Follow its connections.{% endif %}</p></section><aside id="library-detail" aria-label="{{ library.ui.detail }}" hidden></aside></div>
<nav id="library-themes" class="library-themes" aria-label="{% if de %}Historische Themen{% else %}Historical themes{% endif %}"><span>{% if de %}Historische Räume{% else %}Historical worlds{% endif %}</span></nav>
<section class="library-shelf" aria-label="{{ library.ui.list }}"><div class="shelf-heading"><h2 id="shelf-title">{% if de %}Durch die Bibliothek streifen{% else %}Wander through the library{% endif %}</h2><div><button id="shelf-prev" aria-label="{% if de %}Vorherige Bücher{% else %}Previous books{% endif %}">←</button><button id="shelf-next" aria-label="{% if de %}Weitere Bücher{% else %}More books{% endif %}">→</button></div></div><ul id="library-list">{% for node in library.nodes %}<li><a href="{{ node.url }}">{{ node.label | escape }}</a></li>{% endfor %}</ul></section><noscript><a href="{% if de %}/buecher/{% else %}/books/{% endif %}">{% if de %}Zum Buchkatalog{% else %}Book catalogue{% endif %}</a></noscript></main>
<script type="application/json" id="library-data">{{ library.payload | safe }}</script><script src="/assets/vendor/d3-7.9.0.min.js" defer></script><script src="/assets/vendor/topojson-client-3.1.0.min.js" defer></script><script src="/assets/js/library-network.js?v=20260923-atlas2" defer></script></body></html>
