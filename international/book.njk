---
layout: layout.njk
pagination:
  data: site.books
  size: 1
  alias: book
  addAllPagesToCollections: true
permalink: "{{ book.url }}index.html"
eleventyComputed:
  title: "{{ book.title }} · {{ book.authorName }}"
  description: "{{ book.description.short }}"
---
<div class="shell breadcrumb"><a href="/books/">Books</a><span>/</span><span>{{ book.title }}</span></div>
<section class="shell book-detail"><div class="detail-art">{% set cover = book.cover | existingImage %}{% if cover %}<img src="{{ cover }}" alt="{{ book.title | escape }}" width="400" height="600">{% else %}<div class="type-cover"><small>AETERNUS</small><strong>{{ book.title }}</strong><span>{{ book.authorName }}</span></div>{% endif %}</div><div class="detail-copy"><p class="kicker"><span class="series-dot" style="--series-color:{{ book.seriesColor }}"></span><a href="/series/{{ book.series }}/">{{ book.seriesName }}</a></p><a class="detail-author" href="{{ book.authorUrl }}">{{ book.authorName }}</a><h1>{{ book.title }}</h1>{% if book.subtitle %}<p class="detail-subtitle">{{ book.subtitle }}</p>{% endif %}<p class="detail-description">{{ book.description.short }}</p><div class="actions">{% set publisherBuyUrl = book | directSalesUrl %}{% set buyUrl = book | shopUrl('en') %}{% if publisherBuyUrl %}<a class="button ink-button" href="{{ publisherBuyUrl }}">BUY DIRECT FROM THE PUBLISHER →</a>{% elif buyUrl %}<a class="button ink-button" href="{{ buyUrl }}">BUY DIRECT →</a>{% elif book.links.amazon %}<a class="button ink-button" href="#editions">Formats & buying options →</a>{% else %}<a class="button outline-button" href="/shop/">Direct shop forthcoming →</a>{% endif %}</div><p class="edition-note">English-language edition · {{ book.seriesName }}</p></div></section>
{% include 'history-context.njk' %}
<section class="shell detail-section"><div><p class="kicker">Inside the edition</p><h2>About this book.</h2></div><div class="prose"><p>{{ book.legacy.modal.sample | plain }}</p><p>{{ book.legacy.modal.metadata | plain }}</p><a class="text-link" href="/editorial-method/">Our editorial method →</a></div></section>
{% if book.retailer_formats.length %}<section class="shell detail-section" id="editions"><div><p class="kicker">Formats & availability</p><h2>Find your edition.</h2><p>Local prices, taxes, delivery and availability are shown by the retailer.</p></div><div class="format-list">{% for format in book.retailer_formats %}<article><h3>{{ format.label }}</h3>{% if format.isbn %}<p>ISBN {{ format.isbn }}</p>{% endif %}{% if format.price_display %}<p>{{ format.price_display }}</p>{% endif %}<div class="retailer-links">{% for link in format.links %}<a class="text-link" href="{{ link.url }}" target="_blank" rel="noopener noreferrer">Amazon {{ link.label }} ↗</a>{% endfor %}</div>{% if not format.links.length %}<p>{% if book.distribution_status.ingram == 'LIVE' %}Ask your bookseller using this ISBN.{% else %}Retail availability forthcoming.{% endif %}</p>{% endif %}</article>{% endfor %}</div></section>{% endif %}

{% for post in site.social.instagram.posts %}{% if post.book_id == book.id %}<section class="shell detail-section"><div><p class="kicker">Beyond the printed page</p><h2>This edition on Instagram.</h2></div><div class="prose"><p>Discover the book and its artwork on our English Instagram profile.</p><a class="text-link" href="{{ post.url }}" target="_blank" rel="noopener noreferrer">View this book on @aeternus.publishing ↗</a></div></section>{% endif %}{% endfor %}

<p class="shell international-section"><a class="text-link" href="/book-universe/?node=book:{{ book.id }}">Explore connections in the Book Universe →</a></p>
