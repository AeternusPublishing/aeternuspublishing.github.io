---
layout: layout.njk
pagination:
  data: site.books
  size: 1
  alias: book
  addAllPagesToCollections: true
permalink: "{{ book.url }}index.html"
eleventyComputed:
  title: "{{ book.title }} · {{ book.authorName }}"
  description: "{{ book.description.short }}"
---
<div class="shell breadcrumb"><a href="/books/">Books</a><span>/</span><span>{{ book.title }}</span></div>
<section class="shell book-detail"><div class="detail-art">{% set cover = book.cover | existingImage %}{% if cover %}<img src="{{ cover }}" alt="{{ book.title | escape }}" width="400" height="600">{% else %}<div class="type-cover"><small>AETERNUS</small><strong>{{ book.title }}</strong><span>{{ book.authorName }}</span></div>{% endif %}</div><div class="detail-copy"><p class="kicker"><span class="series-dot" style="--series-color:{{ book.seriesColor }}"></span><a href="/series/{{ book.series }}/">{{ book.seriesName }}</a></p><a class="detail-author" href="{{ book.authorUrl }}">{{ book.authorName }}</a><h1>{{ book.title }}</h1>{% if book.subtitle %}<p class="detail-subtitle">{{ book.subtitle }}</p>{% endif %}<p class="detail-description">{{ book.description.short }}</p><div class="actions">{% set buyUrl = book | shopUrl('en') %}{% if buyUrl %}<a class="button ink-button" href="{{ buyUrl }}">BUY DIRECT →</a>{% else %}<a class="button outline-button" href="/shop/">Direct shop forthcoming →</a>{% endif %}</div><p class="edition-note">English-language edition · {{ book.seriesName }}</p></div></section>
<section class="shell detail-section"><div><p class="kicker">Inside the edition</p><h2>About this book.</h2></div><div class="prose"><p>{{ book.legacy.modal.sample | plain }}</p><p>{{ book.legacy.modal.metadata | plain }}</p><a class="text-link" href="/editorial-method/">Our editorial method →</a></div></section>
