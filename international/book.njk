---
layout: layout.njk
pagination:
  data: site.books
  size: 1
  alias: book
  addAllPagesToCollections: true
permalink: "{{ book.url }}index.html"
eleventyComputed:
  title: "{{ book.title | safe }} · {{ book.authorName | safe }}"
  description: "{{ book.description.short | safe }}"
---
<div class="shell breadcrumb"><a href="/books/">Books</a><span>/</span><span>{{ book.title }}</span></div>{% if book.collectionUrl %}<p class="shell edition-note"><a class="text-link" href="{{ book.collectionUrl }}">{{ book.collectionTitle }} →</a></p>{% endif %}
<section class="shell book-detail"><div class="detail-art">{% set cover = book.cover | existingImage %}{% if cover %}{% if book.coverWebp %}<picture><source type="image/webp" srcset="{{ book.coverWebp }}">{% endif %}<img src="{{ cover }}" alt="{{ book.title | escape }}" width="400" height="600">{% if book.coverWebp %}</picture>{% endif %}{% else %}<div class="type-cover"><small>AETERNUS</small><strong>{{ book.title }}</strong><span>{{ book.authorName }}</span></div>{% endif %}</div><div class="detail-copy"><p class="kicker"><span class="series-dot" style="--series-color:{{ book.seriesColor }}"></span><a href="/series/{{ book.series }}/">{{ book.seriesName }}</a></p><a class="detail-author" href="{{ book.authorUrl }}">{{ book.authorName }}</a><h1>{{ book.title }}</h1>{% if book.subtitle %}<p class="detail-subtitle">{{ book.subtitle }}</p>{% endif %}{% if book.series_line %}<p class="edition-note">{{ book.series_line }}</p>{% endif %}<p class="detail-description">{{ book.description.short }}</p><div class="actions">{% set buyUrl = book | shopUrl('en') %}{% if buyUrl %}<a class="button ink-button" href="{{ buyUrl }}">BUY DIRECT →</a>{% elif book.links.amazon %}<a class="button ink-button" href="#editions">Formats & buying options →</a>{% elif book.author == "henry-rider-haggard" %}<span class="edition-note">{{ book.status_line }}</span>{% elif book.forthcoming_label %}<span class="edition-note">{{ book.forthcoming_label }}</span>{% elif book.author == "arthur-conan-doyle" and book.work_id != "ACD_002" %}<span class="edition-note">Submitted to IngramSpark · eProof pending</span>{% elif book.work_id == "WGS_001" or book.work_id == "DCB_001" or book.work_id == "RLS_001" or book.work_id == "TR_002" or book.work_id == "COO_001" or book.work_id == "NAJ_001" or book.work_id == "ETA_001" %}<span class="edition-note">Forthcoming</span>{% else %}<a class="button outline-button" href="/shop/">Direct shop forthcoming →</a>{% endif %}</div><p class="edition-note">English-language edition · {{ book.seriesName }}</p></div></section>
{% if book.original_title == 'The White Company' %}<p class="shell edition-note"><a class="text-link" href="/books/the-white-company/">The White Company · Explore all three volumes →</a></p>{% endif %}
{% if book.author == 'henry-rider-haggard' %}<p class="shell edition-note">Live · AMBER SERIES · AETERNUS</p>{% endif %}
{% if book.relaunch_status %}<p class="shell edition-note">{{ book.cardStatus }}</p>{% endif %}
{% include 'history-context.njk' %}
{% if book.backcover %}<section class="shell detail-section"><div><p class="kicker">The edition</p><h2>Back cover.</h2></div><figure class="detail-art"><picture>{% if book.backcoverWebp %}<source type="image/webp" srcset="{{ book.backcoverWebp }}">{% endif %}<img src="{{ book.backcover }}" alt="Back cover of {{ book.title | escape }}" width="400" height="600" loading="lazy"></picture></figure></section>{% endif %}
<section class="shell detail-section"><div><p class="kicker">Inside the edition</p><h2>About this book.</h2></div><div class="prose">{% if book.blurb %}{% for paragraph in book.blurb %}<p>{{ paragraph | safe }}</p>{% endfor %}{% if book.press_quote %}<blockquote><p>{{ book.press_quote.text }}</p><cite>{{ book.press_quote.source }}</cite></blockquote>{% endif %}{% if book.features %}<ul>{% for feature in book.features %}<li>{{ feature }}</li>{% endfor %}</ul>{% elif book.illustrations %}<p>{{ book.illustrations }}</p>{% endif %}<p>First published: {{ book.first_published }}</p>{% elif book.publisherDescriptionHTML %}{% if book.author == "henry-rider-haggard" and book.press_quote %}<blockquote><p>{{ book.press_quote.text }}</p><cite>{{ book.press_quote.source }}</cite></blockquote>{% endif %}{{ book.publisherDescriptionHTML | safe }}{% else %}<p>{{ book.legacy.modal.sample | plain }}</p>{% endif %}{% if not book.blurb %}<p>{{ book.legacy.modal.metadata | plain }}</p>{% endif %}<a class="text-link" href="/editorial-method/">Our editorial method →</a></div></section>
{% if book.retailer_formats.length %}<section class="shell detail-section" id="editions"><div><p class="kicker">Formats & availability</p><h2>Find your edition.</h2>{% if book.work_id == "NAJ_001" %}<p>Paperback and hardcover forthcoming.</p>{% else %}<p>Local prices, taxes, delivery and availability are shown by the retailer.</p>{% endif %}</div><div class="format-list">{% for format in book.retailer_formats %}<article><h3>{{ format.label }}</h3>{% if format.isbn %}<p>ISBN {{ format.isbn }}</p>{% endif %}{% if format.pages %}<p>{{ format.pages }} pages</p>{% endif %}{% if format.price_display %}<p>{{ format.price_display }}</p>{% endif %}<div class="retailer-links">{% for link in format.links %}<a class="text-link" href="{{ link.url }}" target="_blank" rel="noopener noreferrer">Amazon {{ link.label }} ↗</a>{% endfor %}</div>{% if not format.links.length %}<p>{% if book.author == 'henry-rider-haggard' %}Live.{% elif book.distribution_status.ingram == 'LIVE' %}Ask your bookseller using this ISBN.{% else %}Retail availability forthcoming.{% endif %}</p>{% endif %}</article>{% endfor %}</div></section>{% endif %}

{% for post in site.social.instagram.posts %}{% if post.book_id == book.id %}<section class="shell detail-section"><div><p class="kicker">Beyond the printed page</p><h2>This edition on Instagram.</h2></div><div class="prose"><p>Discover the book and its artwork on our English Instagram profile.</p><a class="text-link" href="{{ post.url }}" target="_blank" rel="noopener noreferrer">View this book on @aeternus.publishing ↗</a></div></section>{% endif %}{% endfor %}

<p class="shell international-section"><a class="text-link" href="/book-universe/?node=book:{{ book.id }}">Explore connections in the Book Universe →</a></p>
