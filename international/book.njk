---
layout: layout.njk
pagination:
  data: site.books
  size: 1
  alias: book
  addAllPagesToCollections: true
permalink: "{{ book.url }}index.html"
eleventyComputed:
  title: "{{ book.title | safe }} · {{ book.authorName | safe }}"
  description: "{{ book.description.short | safe }}"
---
<div class="shell breadcrumb"><a href="/books/">Books</a><span>/</span><span>{{ book.title }}</span></div>{% if book.collectionUrl %}<p class="shell edition-note collection-trail"><a class="text-link" href="{{ book.collectionSeriesUrl }}">{{ book.collectionSeriesTitle }}</a>{% if book.collectionLineUrl %} › <a class="text-link" href="{{ book.collectionLineUrl }}">{{ book.collectionLineTitle }}</a>{% endif %} › <a class="text-link" href="{{ book.collectionUrl }}">{{ book.collectionTitle }} →</a></p>{% endif %}
<section class="shell book-detail"><div class="detail-art">{% set cover = book.cover | existingImage %}{% if cover %}{% if book.coverWebp %}<picture><source type="image/webp" srcset="{{ book.coverWebp }}">{% endif %}<img src="{{ cover }}" alt="{{ book.title | escape }}" width="400" height="600">{% if book.coverWebp %}</picture>{% endif %}{% else %}<div class="type-cover"><small>AETERNUS</small><strong>{{ book.title }}</strong><span>{{ book.authorName }}</span></div>{% endif %}</div><div class="detail-copy"><p class="kicker"><span class="series-dot" style="--series-color:{{ book.seriesColor }}"></span><a href="/series/{{ book.series }}/">{{ book.seriesName }}</a></p><a class="detail-author" href="{{ book.authorUrl }}">{{ book.authorName }}</a><h1>{{ book.title }}</h1>{% if book.subtitle %}<p class="detail-subtitle">{{ book.subtitle }}</p>{% endif %}{% if book.series_line %}<p class="edition-note">{{ book.series_line }}</p>{% endif %}<p class="detail-description">{{ book.description.short }}</p>{% if book.availabilityNote %}<p class="edition-note">{{ book.availabilityNote }}</p>{% endif %}<div class="actions">{% set buyUrl = book | shopUrl('en') %}{% if buyUrl %}<a class="button ink-button" href="{{ buyUrl }}">BUY DIRECT →</a>{% elif book.availability == "AVAILABLE" %}<a class="button ink-button" href="#editions">Buy this edition →</a>{% elif book.forthcoming_label %}<span class="status-pill status-soon">{{ book.forthcoming_label }}</span>{% else %}<span class="status-pill status-soon">Coming soon</span>{% endif %}</div><p class="edition-note">English-language edition · {{ book.seriesName }}</p></div></section>
{% if book.original_title == 'The White Company' %}<p class="shell edition-note"><a class="text-link" href="/books/the-white-company/">The White Company · Explore all three volumes →</a></p>{% endif %}
{% if book.author == 'henry-rider-haggard' %}<p class="shell edition-note">Live · AMBER SERIES · AETERNUS</p>{% endif %}
{% if book.relaunch_status %}<p class="shell edition-note">{{ book.cardStatus }}</p>{% endif %}
{% include 'history-context.njk' %}
{% if book.backcover %}<section class="shell detail-section"><div><p class="kicker">The edition</p><h2>Back cover.</h2></div><figure class="detail-art"><picture>{% if book.backcoverWebp %}<source type="image/webp" srcset="{{ book.backcoverWebp }}">{% endif %}<img src="{{ book.backcover }}" alt="Back cover of {{ book.title | escape }}" width="400" height="600" loading="lazy"></picture></figure></section>{% endif %}
<section class="shell detail-section"><div><p class="kicker">Inside the edition</p><h2>About this book.</h2></div><div class="prose">{% if book.blurb %}{% for paragraph in book.blurb %}<p>{{ paragraph | safe }}</p>{% endfor %}{% if book.press_quote %}<blockquote><p>{{ book.press_quote.text }}</p><cite>{{ book.press_quote.source }}</cite></blockquote>{% endif %}{% if book.features %}<ul>{% for feature in book.features %}<li>{{ feature }}</li>{% endfor %}</ul>{% elif book.illustrations %}<p>{{ book.illustrations }}</p>{% endif %}<p>First published: {{ book.first_published }}</p>{% elif book.publisherDescriptionHTML %}{% if book.author == "henry-rider-haggard" and book.press_quote %}<blockquote><p>{{ book.press_quote.text }}</p><cite>{{ book.press_quote.source }}</cite></blockquote>{% endif %}{{ book.publisherDescriptionHTML | safe }}{% else %}<p>{{ book.legacy.modal.sample | plain }}</p>{% endif %}{% if not book.blurb %}<p>{{ book.legacy.modal.metadata | plain }}</p>{% endif %}<a class="text-link" href="/editorial-method/">Our editorial method →</a></div></section>
{% if book.retailer_formats.length %}<section class="shell detail-section" id="editions"><div><p class="kicker">Formats &amp; availability</p><h2>Find your edition.</h2><p>Prices are US list prices. Local prices, taxes and delivery are shown by the retailer.</p>{% if book.retailer_formats | selectattr("buy") | length %}<label class="market-select">Shop on Amazon in <select data-amazon-market><option value="com">United States</option><option value="co.uk">United Kingdom</option><option value="ca">Canada</option><option value="com.au">Australia</option></select></label>{% endif %}</div><div class="format-list">{% for format in book.retailer_formats %}{% if format.status == "LIVE" or not book.hideAvailabilityTeaser %}<article class="buy-format"><div class="buy-format-head"><h3>{{ format.label }}</h3>{% if format.price_display %}<p class="buy-price">{{ format.price_display }}</p>{% endif %}</div><p class="buy-spec">{% if format.pages %}{{ format.pages }} pages{% if format.isbn %} · {% endif %}{% endif %}{% if format.isbn %}ISBN {{ format.isbn }}{% endif %}</p>{% if format.buy %}<div class="buy-actions"><a class="button ink-button" data-amazon data-asin="{{ format.buy.asin or '' }}" data-isbn="{{ format.buy.isbn13 }}" href="{{ format.buy.amazon }}" target="_blank" rel="noopener noreferrer">Buy on Amazon<span data-amazon-domain>.com</span> ↗</a></div>{% if format.buy.others.length %}<p class="buy-others">Other booksellers: {% for link in format.buy.others %}<a class="text-link" href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.label }} ↗</a>{% endfor %}</p>{% endif %}{% elif format.links.length %}<div class="retailer-links">{% for link in format.links %}<a class="text-link" href="{{ link.url }}" target="_blank" rel="noopener noreferrer">Amazon {{ link.label }} ↗</a>{% endfor %}</div>{% else %}<p><span class="status-pill status-soon">{% if format.availability_note %}{{ format.availability_note }}{% else %}Coming soon{% endif %}</span></p>{% endif %}</article>{% endif %}{% endfor %}</div></section>{% endif %}

{% set supplement = book.supplement %}{% include "book-supplement.njk" %}
{% if book.illustrationPreviews.length %}
<section class="shell detail-section"><div><p class="kicker">Inside the book</p><h2>Maps &amp; illustrations.</h2><p>Pages from this edition. Select an image to view the full page.</p></div><div class="edition-previews">{% for image in book.illustrationPreviews %}<figure><a href="{{ image.src }}" target="_blank" rel="noopener noreferrer" aria-label="View full page: {{ image.alt | escape }}"><img src="{{ image.src }}" alt="{{ image.alt | escape }}" width="{{ image.width }}" height="{{ image.height }}" loading="lazy"></a><figcaption>{{ image.caption }}</figcaption></figure>{% endfor %}</div></section>
{% endif %}
{% for post in site.social.instagram.posts %}{% if post.book_id == book.id %}<section class="shell detail-section"><div><p class="kicker">Beyond the printed page</p><h2>This edition on Instagram.</h2></div><div class="prose"><p>Discover the book and its artwork on our English Instagram profile.</p><a class="text-link" href="{{ post.url }}" target="_blank" rel="noopener noreferrer">View this book on @aeternus.publishing ↗</a></div></section>{% endif %}{% endfor %}

<p class="shell international-section"><a class="text-link" href="/book-universe/?node=book:{{ book.id }}">Explore connections in the Book Universe →</a></p>
