---
layout: layout.njk
lang: en
collectionPage: true
pagination:
  data: site.collectionPages
  size: 1
  alias: collection
  addAllPagesToCollections: true
permalink: "{{ collection.url }}index.html"
eleventyComputed:
  title: "{{ collection.title | safe }}{% if collection.lineInfo %} · {{ collection.lineInfo.title }}{% endif %}"
  description: "{{ collection.intro }}"
---
<div class="collection-hero cl-hero cl-hero-{{ collection.series }}"><div class="shell collection-hero-inner">
  <nav class="collection-crumbs" aria-label="Breadcrumb"><a href="/collections/">Collections</a><span aria-hidden="true">/</span><a href="{{ collection.seriesUrl }}">{{ collection.seriesInfo.name.en }}</a>{% if collection.lineInfo %}<span aria-hidden="true">/</span><a href="{{ collection.lineInfo.url }}">{{ collection.lineInfo.title }}</a>{% endif %}<span aria-hidden="true">/</span><span aria-current="page">{{ collection.title }}</span></nav>
  <p class="kicker light-kicker">{% if collection.lineInfo %}{{ collection.lineInfo.title }} · {{ collection.nr }}{% else %}{{ collection.seriesInfo.name.en }} Series{% endif %}</p>
  <h1>{{ collection.title }}</h1>
  {% if collection.region %}<p class="collection-subtitle">{{ collection.region }}</p>{% endif %}
  <p>{{ collection.intro }}</p>
  {% if collection.siblings.length > 1 %}<div class="cl-chips">{% for c in collection.siblings %}<a class="cl-chip{% if c.id == collection.id %} cl-on{% endif %}" href="{{ c.url }}"{% if c.id == collection.id %} aria-current="page"{% endif %}>{% if c.nr %}{{ c.nr }} · {% endif %}{{ c.title }}</a>{% endfor %}</div>{% endif %}
</div></div>
{% if collection.inPreparation %}
<section class="shell international-section"><div class="collection-section-head"><p class="kicker">In preparation</p><h2>The first editions are being prepared.</h2><p>This subseries opens with its first English-language editions. The other subseries of {{ collection.lineInfo.title }} are already on the shelves.</p></div></section>
{% endif %}
{% if collection.books.length %}
<section class="shell international-section" aria-labelledby="collection-books">
  <div class="collection-section-head"><p class="kicker">{{ collection.books.length }} edition{% if collection.books.length != 1 %}s{% endif %}</p><h2 id="collection-books">The books.</h2><p>Each book page carries current formats, ISBNs and retailers. A forthcoming edition is marked as such.</p></div>
  <div class="books-grid">{% for item in collection.books %}{% include 'book-card.njk' %}{% endfor %}</div>
</section>
{% endif %}
<nav class="shell international-section collection-endnav" aria-label="Collection navigation">{% if collection.lineInfo %}<a class="text-link" href="{{ collection.lineInfo.url }}">← {{ collection.lineInfo.title }}: all subseries</a>{% endif %}<a class="text-link" href="{{ collection.seriesUrl }}">{{ collection.seriesInfo.name.en }} Series: all lines →</a></nav>
