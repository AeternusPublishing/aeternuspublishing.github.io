---
layout: layout.njk
lang: en
historicalPage: true
pagination:
  data: history.themes
  size: 1
  alias: theme
  addAllPagesToCollections: true
permalink: "{{ theme.url }}index.html"
eleventyComputed:
  title: "{{ theme.title }} · {{ history.labels.title }}"
  description: "{{ theme.subtitle }} · {{ theme.period }}. {{ history.labels.title }} · AETERNUS."
---
<div class="history-world"><header class="shell history-intro"><a class="history-link" href="{{ history.base }}">← {{ history.labels.back }}</a><p class="kicker">{{ history.labels.title }}</p><h1>{{ theme.title }}</h1><p class="history-deck">{{ theme.subtitle }}</p><a class="history-link" href="{{ theme.otherUrl }}" hreflang="de">{{ history.labels.switch }} →</a><p><a class="history-link" href="/book-universe/?node=theme:{{ theme.id }}">Explore this theme in the Book Universe →</a></p></header><div class="shell history-reading"><article class="history-prose" aria-label="{{ theme.title }}">{% for paragraph in theme.body %}<p>{{ paragraph }}</p>{% endfor %}{% for visual in theme.visuals %}{% if visual.src %}<figure><img src="{{ visual.src }}" alt="{{ visual.alt[history.lang] }}" width="{{ visual.width }}" height="{{ visual.height }}" loading="lazy"><figcaption>{{ visual.caption[history.lang] }}</figcaption></figure>{% endif %}{% endfor %}</article><aside class="history-facts"><dl><div><dt>{{ history.labels.period }}</dt><dd>{{ theme.period }}</dd></div><div><dt>{{ history.labels.regions }}</dt><dd>{{ theme.regions | join(' · ') }}</dd></div><div><dt>{{ history.labels.keywords }}</dt><dd>{{ theme.keywords | join(' · ') }}</dd></div></dl></aside></div><section class="shell history-editions"><h2>{{ history.labels.books }}</h2>{% if theme.books.length %}<div class="books-grid">{% for item in theme.books %}{% include 'book-card.njk' %}{% endfor %}</div>{% else %}<p class="history-empty">{{ history.labels.empty }}</p>{% endif %}</section><nav class="shell history-connections" aria-label="{{ history.labels.related }}">{% for links, label in [[theme.parents, history.labels.parents], [theme.children, history.labels.children], [theme.related, history.labels.related]] %}{% if links.length %}<h2>{{ label }}</h2><ul>{% for related in links %}<li><a href="{{ related.url }}">{{ related.title }} →</a></li>{% endfor %}</ul>{% endif %}{% endfor %}</nav><section class="shell history-sources"><h2>{{ history.labels.sources }}</h2><ul>{% for source in theme.sources %}<li><a href="{{ source.url }}">{{ source.title }}</a></li>{% endfor %}</ul></section></div>
