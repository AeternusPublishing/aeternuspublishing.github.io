---
layout: layout.njk
pagination:
  data: information
  size: 1
  alias: info
  addAllPagesToCollections: true
permalink: "/{{ info.slug }}/index.html"
eleventyComputed:
  title: "{{ info.title }}"
  description: "{{ info.description }}"
---
<section class="shell page-intro"><p class="kicker">{{ info.kicker }}</p><h1>{{ info.title }}</h1></section>
<section class="shell prose">{% for section in info.sections %}<h2>{{ section.heading }}</h2><p>{{ section.text }}</p>{% endfor %}{% if info.link %}<p><a class="text-link" href="{{ info.link.url }}">{{ info.link.label }} →</a></p>{% endif %}</section>

{% if info.links %}<div class="shell prose">{% for link in info.links %}<p><a class="text-link" href="{{ link.url }}">{{ link.label }} →</a></p>{% endfor %}</div>{% endif %}
