---
layout: layout.njk
pagination:
  data: site.series
  size: 1
  alias: series
  addAllPagesToCollections: true
permalink: "/series/{{ series.id }}/index.html"
eleventyComputed:
  title: "{{ series.name.en }} Series"
  description: "{{ series.label.en }} — the {{ series.name.en }} series at AETERNUS PUBLISHING."
---
<section class="shell page-intro"><p class="kicker"><span class="series-dot" style="--series-color:{{ series.color }}"></span>AETERNUS SERIES</p><h1>{{ series.name.en }}</h1><p>{{ series.label.en | plain }}</p></section>{% if series.id == 'gruen' %}{% include 'history-teaser.njk' %}{% endif %}<section class="shell international-section">{% set books = series.id | seriesBooks %}{% if books.length %}<div class="books-grid">{% for item in books %}{% include 'book-card.njk' %}{% endfor %}</div>{% else %}<p>The English-language programme for this series is in preparation.</p><a class="text-link" href="/series/">Explore all series →</a>{% endif %}</section>
