---
layout: layout.njk
pagination:
  data: site.series
  size: 1
  alias: series
  addAllPagesToCollections: true
permalink: "/series/{{ series.id }}/index.html"
eleventyComputed:
  title: "{{ series.name.en }} Series"
  description: "{{ series.label.en }} — the {{ series.name.en }} series at AETERNUS PUBLISHING."
---
<section class="series-scene" style="--series-color:{{ series.color }}">{% if series.mood.file %}<picture class="series-scene-image"><source type="image/avif" srcset="/assets/images/{{ series.mood.file }}.avif"><source type="image/webp" srcset="/assets/images/{{ series.mood.file }}.webp"><img src="/assets/images/{{ series.mood.file }}.jpg" alt="{{ series.mood.alt.en }}" style="object-position:{{ series.mood.focal }}" fetchpriority="high"></picture>{% endif %}<div class="shell series-scene-copy"><p class="kicker"><span class="series-dot" style="--series-color:{{ series.color }}"></span>AETERNUS SERIES</p><h1>{{ series.name.en }}</h1><p>{{ series.label.en | plain }}</p>{% if series.mood.credit.public %}<p class="series-image-credit">{{ series.mood.credit.artist }} · <cite>{{ series.mood.credit.title.en }}</cite> ({{ series.mood.credit.year }}) · {{ series.mood.credit.museum.en }}</p>{% endif %}</div></section>{% if series.id == 'gruen' %}{% include 'history-teaser.njk' %}{% endif %}<section class="shell international-section">{% set books = series.id | seriesBooks %}{% if books.length %}<div class="books-grid">{% for item in books %}{% include 'book-card.njk' %}{% endfor %}</div>{% else %}<p>The English-language programme for this series is in preparation.</p><a class="text-link" href="/series/">Explore all series →</a>{% endif %}</section>
