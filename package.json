{
  "name": "aeternus-verlag",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "eleventy --serve",
    "prebuild": "node scripts/export-wilderness-register.cjs && node scripts/build-library-graph.cjs",
    "build": "node ./node_modules/@11ty/eleventy/cmd.cjs && node scripts/editorial-images.cjs --write",
    "optimize:images": "node scripts/optimize-images.js",
    "icons": "node scripts/make-icons.js",
    "fonts": "node scripts/fetch-fonts.js",
    "check:hreflang": "node ./scripts/check-hreflang.js",
    "check:pages": "node ./scripts/check-pages.js",
    "check:editorial": "node ./scripts/check-editorial.cjs",
    "check:text": "node ./scripts/check-text.cjs",
    "check:author-order": "node ./scripts/check-author-order.cjs",
    "check:author-worlds": "node ./scripts/check-author-worlds.cjs",
    "check:edition-languages": "node ./scripts/check-edition-languages.cjs",
    "check:book-identities": "node ./scripts/check-book-identities.cjs",
    "check:qr": "node ./scripts/check-qr-targets.js",
    "check:kosmos": "node ./scripts/check-kosmos.cjs",
    "prebuild:international": "node scripts/export-wilderness-register.cjs && node scripts/build-library-graph.cjs",
    "build:international": "eleventy --config=eleventy.international.cjs",
    "preview:international": "eleventy --config=eleventy.international.cjs --serve --port=8092",
    "check:international": "node ./node_modules/@11ty/eleventy/cmd.cjs --output=work/de-after --quiet && node scripts/check-international.cjs",
    "check:green-collections": "node scripts/check-green-collections.cjs",
    "prebuild:international:production": "node scripts/export-wilderness-register.cjs && node scripts/build-library-graph.cjs",
    "build:international:production": "node scripts/build-international-production.cjs",
    "check:wilderness": "node scripts/check-wilderness.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "html-minifier-terser": "^7.2.0",
    "sharp": "^0.35.2"
  }
}
