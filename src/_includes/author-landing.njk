{% set world = a.slug | authorWorld(authorLocale) %}
{% set worldEnglishBooks = a.slug | worldEnglishBooks(true) %}
{% set worldWorksId = labels.worksId %}
{% set worldBioId = labels.bioId %}
<body class="editorial-site international-site">
<a class="skip-link" href="#main">{{ labels.skip }}</a>
<header class="masthead"><div class="shell masthead-inner">
  <a class="international-brand" href="{{ labels.home }}"><img src="/assets/images/logo.svg" alt="AETERNUS Verlag" width="832" height="50"></a>
  <nav class="main-navigation author-local-nav" aria-label="{{ labels.navigation }}">
    <a href="/buecher/">{{ labels.catalogue }}</a><a href="#{{ labels.worksId }}">{{ labels.works }}</a>{% if a.blocks.length or a.bioLede %}<a href="#{{ labels.bioId }}">{{ labels.bio }}</a>{% endif %}
    {% for v in authorLangs.versions(a.slug, authorLocale) %}<a href="{{ v.url }}" hreflang="{{ v.lang }}"{% if v.current %} aria-current="page"{% endif %}>{{ v.label }}</a>{% endfor %}
  </nav>
</div></header>
{% if a.preview %}<p class="author-preview-note">{{ a.previewBanner or a.previewStatus or labels.preview }}</p>{% endif %}
<main id="main" class="author-page">
{% if world %}{% include "editorial/author-worlds/components/hero.njk" %}{% else %}<section class="shell author-hero{% if not a.portrait.file %} no-portrait{% endif %}">
  <div><p class="kicker">{{ a.eyebrow | striptags }}</p><h1>{{ a.name }}</h1><p>{{ a.dates | safe }}</p><p class="detail-subtitle">{{ a.tagline }}</p><p>{{ a.intro | safe }}</p></div>
  {% set portrait = a.portrait.file | authorImage(a.portrait.modern) %}
  {% if portrait %}<figure><img src="{{ portrait }}" alt="{{ a.portrait.alt or a.name }}" width="250" height="310"></figure>{% endif %}
</section>{% endif %}
<section class="shell international-section" id="{{ labels.worksId }}" aria-labelledby="works-title">
  <div class="section-heading"><h2 id="works-title">{% if world and authorLocale == 'en' and not worldEnglishBooks.length %}German-language editions{% else %}{{ "Englischsprachige Ausgaben" if authorLocale == 'de' and a.editionLanguage == 'en' else labels.editions }}{% endif %}</h2></div>
  {% if world.bridge %}<p class="world-book-bridge">{{ world.bridge }}</p>{% endif %}
  {% if world and a.sisterUrl and a.sisterUrl != '/autoren/' %}<p class="edition-note"><a href="{{ a.sisterUrl }}">{{ a.sisterLabel }} →</a></p>{% endif %}
{% if world and authorLocale == "en" %}{% include "editorial/author-worlds/components/books-en.njk" %}{% else %}  <div class="author-books{% if a.books.length == 1 %} single-book{% endif %}">
  {% if authorLocale == 'de' and a.editionLanguage == 'en' %}
    <p>Die Ausgaben dieses Autors finden Sie auf unserer englischen Verlagsseite: <a class="text-link" href="{{ a.sisterUrl }}">Zu den englischsprachigen Ausgaben →</a></p>
  {% else %}
  {% for bk in a.books %}
    {% set directBookUrl = bk.url or (bk.cover.img | bookUrl) if authorLocale == 'de' else bk.url %}
    {% set cover = bk.cover.img | authorImage(true, true) %}
    <article class="author-book" id="{{ bk.id or ('book-' + loop.index) }}">
      <a class="book-art" href="{{ directBookUrl or ('#details-' + loop.index) }}">
      {% if cover %}<img src="{{ cover }}" alt="{{ bk.title | striptags }}" width="400" height="600" loading="lazy">
      {% else %}<span class="type-cover"><small>AETERNUS</small><strong>{{ bk.title | striptags }}</strong><span>{{ a.name }}</span></span>{% endif %}</a>
      <div class="author-book-copy"><p class="kicker">{{ bk.meta | striptags }}</p><h3>{% if directBookUrl %}<a href="{{ directBookUrl }}">{% endif %}{{ bk.title | safe }}{% if directBookUrl %}</a>{% endif %}</h3>
        <p>{{ (bk.modal.summary or bk.subtitle) | striptags | truncate(220) }}</p>
        {% if bk.status or bk.modal.status %}<p class="edition-note">{{ bk.status or bk.modal.status }}</p>{% endif %}
        {% if directBookUrl %}<a class="text-link" href="{{ directBookUrl }}">{{ labels.bookLink }} →</a>{% endif %}
      </div>
      <details id="details-{{ loop.index }}"><summary>{{ labels.details }} · {{ bk.title | striptags }}</summary><div class="edition-copy">
        <p>{{ bk.subtitle | safe }}</p><p>{{ bk.modal.metadata }}</p><p>{{ bk.modal.summary | safe }}</p><div>{{ bk.modal.sample | safe }}</div>
        {% if bk.availabilityNote %}<p>{{ bk.availabilityNote }}</p>{% endif %}
        {% for f in bk.formats %}<h4>{{ f.name }}</h4><p>{{ f.price }}{% if f.isbn %} · ISBN {{ f.isbn }}{% endif %}</p>
          {% if f.links.length %}<ul>{% for link in f.links %}<li><a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.label }} ↗</a></li>{% endfor %}</ul>{% endif %}
        {% endfor %}
        {% if not bk.formats.length and bk.modal.amazon and not a.preview and bk.modal.amazon != '#' %}<a class="text-link" href="{{ "/buecher/" if bk.modal.amazon == "/autoren/" else bk.modal.amazon }}">{{ a.modalActionLabel or labels.buyLink }} →</a>{% endif %}
      </div></details>
    </article>
  {% endfor %}
  {% endif %}
  </div>{% endif %}
</section>
{% if world %}{% include "editorial/author-worlds/components/content.njk" %}{% else %}{% if a.blocks.length or a.bioLede %}<section class="shell international-section author-biography" id="{{ labels.bioId }}" aria-labelledby="bio-title">
  <div><p class="kicker">{{ labels.context }}</p><h2 id="bio-title">{{ labels.about }} {{ a.name }}</h2></div>
  <div class="biography-copy">
    {% if a.bioLede %}<p>{{ a.bioLede | safe }}</p>{% endif %}
    <details><summary>{{ labels.readBio }}</summary>{% for b in a.blocks %}<h3>{{ b.h | safe }}</h3>{% for p in b.p %}<p>{{ p | safe }}</p>{% endfor %}{% endfor %}</details>
  </div>
</section>
{% endif %}
{% endif %}
{% if not world and (a.facts or a.worksIntro or a.editionsNote) %}<section class="shell international-section author-edition-notes"><details><summary>{{ labels.more }}</summary><div class="prose">
  <h2>{{ a.worksTitle | safe }}</h2><p>{{ a.worksIntro | safe }}</p>
  <div class="author-facts">{% for f in a.facts %}<p>{{ f[0] }}<strong>{{ f[1] | safe }}</strong></p>{% endfor %}</div>
  <p>{{ a.editionsNote | safe }}</p>{% if a.sisterUrl %}<a href="{{ "/buecher/" if a.sisterUrl == "/autoren/" else a.sisterUrl }}">{{ labels.catalogue if a.sisterUrl == "/autoren/" else a.sisterLabel }} →</a>{% endif %}
</div></details></section>{% endif %}
{% if world and authorLocale == 'en' %}{% include "editorial/author-worlds/components/further-editions.njk" %}{% endif %}
</main>
<footer class="colophon"><div class="shell footer-bottom"><span>© AETERNUS Verlag</span><a href="/impressum/">{{ labels.legal }}</a><a href="/datenschutz/">{{ labels.privacy }}</a><a href="mailto:kontakt@aeternus-verlag.de">kontakt@aeternus-verlag.de</a></div></footer>
<script>document.addEventListener('click',function(event){var link=event.target.closest('a[href^="#details-"]');if(link){var detail=document.getElementById(link.getAttribute('href').slice(1));if(detail)detail.open=true;}});</script>
</body></html>
