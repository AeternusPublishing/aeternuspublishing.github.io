<!doctype html>
<html lang="{{ lang | default('de') }}">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ title }}</title>
<meta name="robots" content="index, follow" />
  <meta name="description" content="{{ description or i18n["meta.description"][lang] }}" />
  <link rel="canonical" href="https://aeternus-verlag.de{{ page.url }}" />
  {% if hreflang %}
  <link rel="alternate" hreflang="de" href="https://aeternus-verlag.de/" />
  <link rel="alternate" hreflang="en" href="https://aeternus-verlag.de/en/" />
  <link rel="alternate" hreflang="x-default" href="https://aeternus-verlag.de/" />
  {% endif %}
  <meta property="og:type" content="website" />
  <meta property="og:title" content="{{ i18n["meta.title"][lang] }}" />
  <meta property="og:description" content="{{ i18n["meta.description"][lang] }}" />
  <meta property="og:url" content="https://aeternus-verlag.de{{ page.url }}" />
  <meta property="og:site_name" content="Aeternus Verlag" />
  <meta property="og:locale" content="{% if lang == 'de' %}de_DE{% else %}en_US{% endif %}" />
  <meta property="og:image" content="https://aeternus-verlag.de/assets/images/hero-library.jpg" />
  <meta property="og:image:width" content="1920" />
  <meta property="og:image:height" content="1080" />
  <meta property="og:image:alt" content="AETERNUS VERLAG — Editionshaus für historische Texte" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title }}" />
  <meta name="twitter:description" content="{{ description or i18n["meta.description"][lang] }}" />
  <meta name="twitter:image" content="https://aeternus-verlag.de/assets/images/hero-library.jpg" />
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://aeternus-verlag.de/#organization",
    "name": "Aeternus Verlag",
    "url": "https://aeternus-verlag.de/",
    "logo": "https://aeternus-verlag.de/assets/images/logo.svg",
    "email": "kontakt@aeternus-verlag.de"
  }
  </script>
<link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png" />
<link rel="preload" as="font" type="font/woff2" crossorigin href="/assets/fonts/fraunces-300-600-italic-latin.woff2" />
<link rel="preload" as="font" type="font/woff2" crossorigin href="/assets/fonts/fraunces-300-600-italic-latin-ext.woff2" />
<link rel="stylesheet" href="/assets/css/fonts.css{% if assetVersion.fonts %}?v={{ assetVersion.fonts }}{% endif %}" />
<link rel="stylesheet" href="/assets/css/style.css{% if assetVersion.style %}?v={{ assetVersion.style }}{% endif %}">
</head>
<body>
{% include 'header.njk' %}
   {{content | safe}} 
{% include 'footer.njk' %}
</body>
</html>
