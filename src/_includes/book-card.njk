<article class="book-tile" data-book-card data-search="{{ item.title }} {{ item.author }} {{ item.description }} {{ item.searchIsbns }}" data-series="{{ item.series }}" data-status="{% if item.pending %}upcoming{% else %}catalogue{% endif %}">
  <a class="book-art" href="{{ item.url }}" aria-label="{{ item.title }} – {{ item.author }}"><picture><source type="image/avif" srcset="/assets/editorial/{{ item.cover }}-240.avif 240w, /assets/editorial/{{ item.cover }}-480.avif 480w" sizes="(max-width: 580px) 35vw, 200px"><source type="image/webp" srcset="/assets/editorial/{{ item.cover }}-240.webp 240w, /assets/editorial/{{ item.cover }}-480.webp 480w" sizes="(max-width: 580px) 35vw, 200px"><img src="/assets/images/{{ item.cover }}-fallback.jpg" alt="{{ item.title }}" width="400" height="600" loading="lazy" decoding="async"></picture><span class="art-arrow" aria-hidden="true">↗</span></a>
  <div class="book-caption"{% if lang == 'en' %} lang="de"{% endif %}><p class="kicker"><span class="series-dot" style="--series-color:{{ item.seriesColor }}"></span>{{ item.seriesName }}{% if item.pending %} · Demnächst{% endif %}</p><p class="book-author"><a href="{{ item.authorUrl }}">{{ item.author }}</a></p><{{ cardHeading | default('h3') }} class="book-card-title"><a href="{{ item.url }}">{{ item.title }}</a></{{ cardHeading | default('h3') }}><p class="book-description">{{ item.description }}</p><a class="text-link" href="{{ item.url }}">Zur Ausgabe <span aria-hidden="true">→</span></a></div>
</article>
