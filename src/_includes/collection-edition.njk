<article><span class="collection-status">{% if item.publicationStatus == 'published' %}Veröffentlicht{% else %}In Vorbereitung{% endif %} · {% if item.language == 'de' %}Deutsche Ausgabe{% else %}Englische Ausgabe{% endif %}</span><h3><a href="{{ item.url }}" lang="{{ item.language }}">{{ item.title }}</a></h3><p>{{ item.author }}</p><a class="text-link" href="{{ item.url }}">Ausgabe ansehen {% if item.language == 'en' %}↗{% else %}→{% endif %}</a></article>
