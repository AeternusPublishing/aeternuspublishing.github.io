
<footer class="site">
  <div class="wrap inner">
    <div class="foot-grid">
      <div class="foot-brand">
        <div class="brand">
          <a href="/">
            <img src="/assets/images/logo.svg" alt="Aeternus Verlag" class="brand-logo" width="832" height="50" loading="lazy" decoding="async" />
          </a>
         
        </div>
     <p class="" style="color:rgba(243, 231, 207, 0.7);
    font-size: 15px;
    line-height: 1.65;">
          {{ i18n["footer.text"][lang] }}
        </p>
      </div>
      <div class="foot-col">
      <h4>{{ i18n["footer.colSeries"][lang] }}</h4>
      <ul><li><a href="{% if lang == 'de' %}/reihen/{% else %}/en/series/{% endif %}#anthrazit">{{ i18n["footer.linkAnthracite"][lang] }}</a></li>
      <li><a href="{% if lang == 'de' %}/reihen/{% else %}/en/series/{% endif %}#gruen">{{ i18n["footer.linkGreen"][lang] }}</a></li>
      <li><a href="{% if lang == 'de' %}/reihen/{% else %}/en/series/{% endif %}#rot">{{ i18n["footer.linkRed"][lang] }}</a></li>
      <li><a href="{% if lang == 'de' %}/reihen/{% else %}/en/series/{% endif %}#blau">{{ i18n["footer.linkBlue"][lang] }}</a></li>
        <li><a href="{% if lang == 'de' %}/reihen/{% else %}/en/series/{% endif %}#bernstein">{{ i18n["footer.linkAmber"][lang] }}</a></li>
      </ul></div>
      <div class="foot-col">
      <h4>{{ i18n["footer.colHouse"][lang] }}</h4>
      <ul><li><a href="{% if lang == 'de' %}/verlag/{% else %}/en/house/{% endif %}">{{ i18n["footer.linkAbout"][lang] }}</a></li>
      <li><a href="{% if lang == 'de' %}/verlag/{% else %}/en/house/{% endif %}#leitbild">{{ i18n["footer.linkMission"][lang] }}</a></li>
          <li><a href="{% if lang == 'de' %}/edition/{% else %}/en/edition/{% endif %}">{{ i18n["footer.linkTranslation"][lang] }}</a></li>
          <li><a href="{% if lang == 'de' %}/presse/{% else %}/en/press/{% endif %}">{{ i18n["footer.linkPress"][lang] }}</a></li>

      </ul></div>
      <div class="foot-col">
      <h4>{{ i18n["footer.colReader"][lang] }}</h4>
        <ul>
          <li><a href="{% if lang == 'de' %}/reihen/{% else %}/en/series/{% endif %}">{{ i18n["footer.linkCatalogue"][lang] }}</a></li>
          <li><a href="{% if lang == 'de' %}/{% else %}/en/{% endif %}#aktuelle-ausgaben">{{ i18n["footer.linkReadingRoom"][lang] }}</a></li>
          <li><a href="{% if lang == 'de' %}/presse/{% else %}/en/press/{% endif %}">{{ i18n["footer.linkContact"][lang] }}</a></li>
      </ul></div>
    </div>
    <div class="foot-end">
      <span>{{ i18n["footer.copyright"][lang] }}</span>
      <a href="/impressum/" style="color: rgba(243,231,207,0.5); font-size: 13px; text-decoration: none; margin-left: 20px; letter-spacing: 0.05em;">Impressum</a>
      <a href="/datenschutz/" style="color: rgba(243,231,207,0.5); font-size: 13px; text-decoration: none; margin-left: 20px; letter-spacing: 0.05em;">Datenschutz</a>
      <a href="https://digitalbau-nord.de" target="_blank" rel="noopener" style="color: rgba(243,231,207,0.5); font-size: 13px; text-decoration: none; margin-left: 20px; letter-spacing: 0.05em;">Website: Digitalbau Nord</a>
    </div>
  </div>
</footer>