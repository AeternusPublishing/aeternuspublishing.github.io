<header class="site">
  <div class="wrap bar">
 
  <a href="/" class="brand-block">
      <div class="logo-wrapper">
        <img src="/assets/images/logo.svg" alt="Aeternus Verlag" class="brand-logo" width="832" height="50" fetchpriority="high" decoding="async" />
      </div>
    </a> 
<div class="nav-container">
      <nav class="primary">
    <a href="{% if lang == 'de' %}/verlag/{% else %}/en/house/{% endif %}">{{ i18n["nav.verlag"][lang] }}</a>
    <a href="{% if lang == 'de' %}/edition/{% else %}/en/edition/{% endif %}">{{ i18n["nav.edition"][lang] }}</a>
    <a href="{% if lang == 'de' %}/reihen/{% else %}/en/series/{% endif %}">{{ i18n["nav.series"][lang] }}</a>
    <a href="{% if lang == 'de' %}/presse/{% else %}/en/press/{% endif %}">{{ i18n["nav.press"][lang] }}</a>
      </nav>
       <!-- Language Selector Toggles -->
    <div class="lang-switch" role="group" aria-label="Language switcher">
          <a href="/" class="lang-btn {% if lang == 'de' %}is-active{% endif %}">DE</a>
          <span class="lang-sep">|</span>
          <a href="/en/" class="lang-btn {% if lang == 'en' %}is-active{% endif %}">EN</a>
        </div>  
</div>
</header>
