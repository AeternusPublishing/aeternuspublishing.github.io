<link rel="stylesheet" href="/assets/css/library-network.css?v=20260923">
<section class="shell library-intro"><p class="kicker">AETERNUS · {% if library.lang == 'de' %}Bücherkosmos{% else %}Book Universe{% endif %}</p><h1>{{ library.ui.title }}</h1><p>{{ library.ui.intro }}</p><a class="text-link" href="https://aeternus-verlag.de/kosmos/">{{ library.ui.map }} →</a> · <a class="text-link" href="{% if library.lang == 'de' %}https://aeternuspublishing.com/book-universe/{% else %}https://aeternus-verlag.de/kosmos/netzwerk/{% endif %}">{% if library.lang == 'de' %}English{% else %}Deutsch{% endif %}</a></section>
<section class="shell library-explorer" aria-label="{{ library.ui.title }}">
  <div class="library-controls"><label>{{ library.ui.search }}<input id="library-search" type="search" autocomplete="off"></label><label>{% if library.lang == 'de' %}Ausgabensprache{% else %}Edition language{% endif %}<select id="library-language"><option value="all">{{ library.ui.all }}</option><option value="de">{{ library.ui.de }}</option><option value="en">{{ library.ui.en }}</option></select></label><button type="button" id="library-reset">{{ library.ui.reset }}</button><button type="button" id="library-zoom-in" aria-label="Zoom in">+</button><button type="button" id="library-zoom-out" aria-label="Zoom out">−</button></div>
  <p id="library-status" role="status" aria-live="polite">{{ library.ui.hint }}</p>
  <div class="library-legend">{% for type, label in library.ui.types %}<span class="library-key key-{{ type }}">{{ label }}</span>{% endfor %}</div>
  <div class="library-layout"><svg id="library-graph" role="group" aria-label="{{ library.ui.title }}"></svg><aside id="library-detail" aria-label="{{ library.ui.detail }}"><p>{{ library.ui.empty }}</p></aside></div>
  <p class="library-note">{{ library.ui.note }}</p>
  <details class="library-directory" open><summary>{{ library.ui.list }}</summary><ul id="library-list">{% for node in library.nodes %}<li><a href="{{ node.url }}">{{ node.label | escape }}</a> <small>{{ node.typeLabel }}{% if node.language %} · {{ node.language | upper }}{% endif %}</small></li>{% endfor %}</ul></details>
</section>
<script type="application/json" id="library-data">{{ library.payload | safe }}</script><script src="/assets/vendor/d3-7.9.0.min.js" defer></script><script src="/assets/js/library-network.js?v=20260923" defer></script>
