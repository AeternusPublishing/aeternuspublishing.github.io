---
layout: editorial-base.njk
lang: de
section: books
pagination:
  data: catalogue.books
  size: 1
  alias: book
  addAllPagesToCollections: true
permalink: "{{ book.url }}index.html"
eleventyComputed:
  title: "{{ book.title }} · {{ book.author }} · AETERNUS Verlag"
  description: "{{ book.description }}"
---
<main id="main">
  <div class="shell breadcrumb"><a href="/">Startseite</a><span>/</span><a href="/buecher/">Bücher</a><span>/</span><span>{{ book.title }}</span></div>
  <section class="shell book-detail">
    <div class="detail-art"><picture><source type="image/avif" srcset="/assets/editorial/{{ book.cover }}-720.avif"><source type="image/webp" srcset="/assets/editorial/{{ book.cover }}-720.webp"><img src="/assets/images/{{ book.cover }}-fallback.jpg" alt="Umschlag: {{ book.title }}" width="400" height="600" fetchpriority="high"></picture><p>{{ book.seriesName }} · AETERNUS</p></div>
    <div class="detail-copy"><p class="kicker"><span class="series-dot" style="--series-color:{{ book.seriesColor }}"></span><a href="/reihen/{{ book.series }}/">Reihe {{ book.seriesName }}</a></p><a class="detail-author" href="{{ book.authorUrl }}">{{ book.author }}</a><h1>{{ book.title }}</h1>{% if book.subtitle %}<p class="detail-subtitle">{{ book.subtitle }}</p>{% endif %}<p class="detail-description">{{ book.description }}</p>
      {% if book.pending %}<p class="availability">Demnächst erhältlich · Bestellmöglichkeiten folgen.</p>{% endif %}
      <div class="actions">{% if book.amazon %}<a class="button ink-button" href="{{ book.amazon }}" target="_blank" rel="noopener noreferrer">{{ book.amazonLabel }} ↗</a>{% endif %}{% if book.id == 'wilde-tiere-die-ich-kannte' %}<a class="button outline-button" href="#leseprobe">Leseprobe öffnen ↓</a>{% endif %}{% if not book.amazon and book.id != 'wilde-tiere-die-ich-kannte' %}<a class="button outline-button" href="#ausgabe">Ausgabe kennenlernen ↓</a>{% endif %}</div>
      <dl class="edition-facts">{% if book.pages %}<div><dt>Umfang</dt><dd>{{ book.pages }} Seiten</dd></div>{% endif %}<div><dt>Sprache</dt><dd>Deutsch</dd></div>{% if book.original %}<div><dt>Original</dt><dd>{{ book.original }}</dd></div>{% endif %}{% if not book.formats.length %}<div><dt>ISBN</dt><dd>{{ book.isbn }}</dd></div>{% endif %}</dl>
    </div>
  </section>
  <section class="detail-section shell" id="ausgabe"><div><p class="kicker">Über das Buch</p><h2>Eine eigene Welt.</h2></div><div class="prose"><p>{{ book.summary }}</p>{% if book.formats.length %}<h3>Die Ausgaben</h3><div class="formats">{% for format in book.formats %}<div class="format-row"><div><strong>{{ format.name }}</strong>{% if format.isbn %}<span>ISBN {{ format.isbn }}</span>{% elif format.asin %}<span>ASIN {{ format.asin }}</span>{% endif %}</div><div>{% if format.price %}<strong>{{ format.price }}</strong>{% endif %}{% if format.url %}<a href="{{ format.url }}" target="_blank" rel="noopener noreferrer">Bei Amazon ↗</a>{% endif %}</div></div>{% endfor %}</div>{% elif book.metadata %}<p class="edition-note">{{ book.metadata }}</p>{% endif %}</div></section>
  {% if book.id == 'wilde-tiere-die-ich-kannte' %}{% include 'reading-sample.njk' %}{% endif %}
  <section class="author-note shell"><div><p class="kicker">{% if book.author == 'Lady Florentia Sale' or book.author == 'Johanna Spyri' %}Die Autorin{% else %}Der Autor{% endif %}</p><h2>{{ book.author }}</h2><p>{{ book.authorIntro }}</p><a class="text-link" href="{{ book.authorUrl }}">Leben und Werk entdecken →</a></div>{% if book.portrait.modern %}<img src="/assets/images/{{ book.portrait.file }}.webp" alt="{{ book.portrait.alt }}" width="210" height="260" loading="lazy">{% endif %}</section>
  <section class="shell related-section"><div class="section-heading"><div><p class="kicker">Weiterlesen</p><h2>Auch eine Entdeckung wert.</h2></div><a href="/buecher/" class="text-link">Alle Bücher →</a></div><div class="books-grid">{% set relatedCount = 0 %}{% for item in catalogue.books %}{% if item.id != book.id and item.series == book.series and relatedCount < 3 %}{% include 'book-card.njk' %}{% set relatedCount = relatedCount + 1 %}{% endif %}{% endfor %}</div></section>
</main>
