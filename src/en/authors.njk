---
pagination:
  data: authorsEn
  size: 1
  alias: a
  # Ohne dieses Flag nimmt Eleventy nur die ERSTE paginierte Seite in
  # collections.all auf — sitemap.njk haette dann nur eine der fuenf
  # englischen Autorenseiten gelistet.
  addAllPagesToCollections: true
permalink: "/en/authors/{{ a.slug }}/index.html"
eleventyExcludeFromCollections: false
---
{% set world = a.slug | authorWorld("en") %}
{%- set authorStatus = (a.previewStatus | default("In preparation · date open")) if a.preview else "" %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ a.name }} | {{ a.brand | default("Aeternus Verlag") }}</title>
  <meta name="description" content="{{ world.description or a.metaDescription }}">
  <meta name="theme-color" content="#0e0d0b"><link rel="canonical" href="https://aeternus-verlag.de/en/authors/{{ a.slug }}/">{%- for v in authorLangs.versions(a.slug, "en") %}<link rel="alternate" hreflang="{{ v.lang }}" href="https://aeternus-verlag.de{{ v.url }}">{%- endfor %}<link rel="alternate" hreflang="x-default" href="https://aeternus-verlag.de{{ authorLangs.xDefault(a.slug) }}">
  <meta property="og:type" content="profile"><meta property="og:locale" content="en_GB"><meta property="og:site_name" content="{{ a.brand | default("Aeternus Verlag") }}"><meta property="og:title" content="{{ a.name }} | {{ a.brand | default("Aeternus Verlag") }}"><meta property="og:description" content="{{ world.tagline or a.tagline }}"><meta property="og:url" content="https://aeternus-verlag.de/en/authors/{{ a.slug }}/"><meta property="og:image" content="https://aeternus-verlag.de{{ world.portrait.file or "/assets/images/hero-library.jpg" }}">
  <meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="{{ a.name }} | {{ a.brand | default("Aeternus Verlag") }}"><meta name="twitter:description" content="{{ world.tagline or a.tagline }}"><meta name="twitter:image" content="https://aeternus-verlag.de{{ world.portrait.file or "/assets/images/hero-library.jpg" }}">
  <link rel="icon" href="/assets/images/logo.svg" type="image/svg+xml">
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"ProfilePage","name":"{{ a.name }}","url":"https://aeternus-verlag.de/en/authors/{{ a.slug }}/","inLanguage":"en","mainEntity":{"@type":"Person","name":"{{ a.name }}",{% if a.slug != "tacitus" and a.slug != "robert-montgomery-bird" %}"birthDate":"{{ a.schema.birthDate }}","deathDate":"{{ a.schema.deathDate }}",{% endif %}"description":"{{ a.schema.description }}"},"publisher":{"@type":"Organization","name":"{{ a.brand | default("Aeternus Verlag") }}","url":"https://aeternus-verlag.de/"}}</script>
<link rel="stylesheet" href="/assets/css/fonts.css"><link rel="stylesheet" href="/assets/css/editorial.css"><link rel="stylesheet" href="/assets/css/author-layout-base.css"><link rel="stylesheet" href="/assets/css/authors.css?v=20261018">
<link rel="stylesheet" href="/assets/css/author-worlds.css?v=20261020">
</head>
{% set authorLocale = "en" %}
{% set labels = authorLabels[authorLocale] %}
{% include "author-landing.njk" %}
