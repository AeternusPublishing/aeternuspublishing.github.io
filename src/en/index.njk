---
title: "AETERNUS VERLAG · Publisher for Historical Texts & Classics"
layout: base.njk
lang: en
permalink: /en/index.html
hreflang: true
---

<main>

<!--HERO SECTION-->
<section class="hero">
  <picture style="display:contents">
    <source type="image/avif" srcset="/assets/images/hero-library.avif" />
    <source type="image/webp" srcset="/assets/images/hero-library.webp" />
    <img class="hero-bg" src="/assets/images/hero-library.jpg" alt="Antique books, military map, brass compass and candle on a mahogany desk" width="1920" height="1080" fetchpriority="high" decoding="async" />
  </picture>
  <div class="hero-veil"></div>
  <div class="hero-vignette vignette"></div>
  <div class="hero-grain paper-grain"></div>
  <div class="wrap hero-inner">
    <div>
      <div class="eyebrow imperial"><span class="line"></span><span>{{ i18n["hero.top-title"][lang] }}</span></div>
      <h1 class="headline">
        <span class="l1 gold-grad">{{ i18n["hero.title"][lang] }} </span>
        <span class="l2"></span>
        <span class="l3"></span>
      </h1>
      <p class="lede">{{ i18n["hero.subtitle"][lang] }}</p>
      <div class="cta-row">
        <a href="#reihen" class="btn btn-primary">{{ i18n["hero.btn1"][lang] }}<span class="ar">→</span></a>
        <a href="#anspruch" class="btn-link">{{ i18n["hero.btn2"][lang] }}</a>
      </div>
    </div>
    <div class="metrics">
      <div class="metric">
      <div class="n">2026</div>
      <div class="l">{{ i18n["metrics.info1.1st"][lang] }}</div>
      </div>
      <div class="metric">
      <div class="n">{{ i18n["metrics.info2.1st"][lang] }}</div>
      <div class="l">{{ i18n["metrics.info2.2nd"][lang] }}</div>
      </div>
      <div class="metric">
      <div class="n">{{ i18n["metrics.info3.1st"][lang] }}</div>
      <div class="l">{{ i18n["metrics.info3.2nd"][lang] }}</div>
      </div>
      <div class="metric">
      <div class="n">{{ i18n["metrics.info4.1st"][lang] }}</div>
      <div class="l">{{ i18n["metrics.info4.2nd"][lang] }}</div>
      </div>
       <div class="metric">
      <div class="n">{{ i18n["metrics.info5.1st"][lang] }}</div>
      <div class="l">{{ i18n["metrics.info5.2nd"][lang] }}</div>
      </div>
    </div>
  </div>
</section>

<!--ANSPRUCH: Editio Perpetua / 7 Grundsätze + Leitbild (zusammengeführt aus #mission + #editorial-pillars) -->
<section id="anspruch" class="block" style="background-color: #161311; position: relative; border-top: 1px solid rgba(212, 175, 55, 0.15);">
  <div class="paper-grain" style="position:absolute;inset:0;opacity:.15;pointer-events:none;"></div>
  <style>
    #anspruch .pillars-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 30px; margin-bottom: 60px; }
    #anspruch .pillar-card { background-color: #1c1815; border: 1px solid rgba(212, 175, 55, 0.08); border-left: 3px solid rgba(212, 175, 55, 0.25); padding: 35px 30px; position: relative; transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1); box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2); }
    #anspruch .pillar-card:hover { transform: translateY(-5px); background-color: #211c19; border-color: rgba(212, 175, 55, 0.25); border-left-color: var(--gold); box-shadow: 0 15px 40px rgba(0, 0, 0, 0.45), 0 0 25px rgba(212, 175, 55, 0.03); }
    #anspruch .pillar-num { font-size: 0.85rem; font-family: sans-serif; color: rgba(243, 231, 207, 0.4); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 12px; transition: color 0.3s ease; }
    #anspruch .pillar-card:hover .pillar-num { color: var(--gold); }
    #anspruch .pillar-title { color: #f3e7cf; font-family: var(--font-display); font-size: 1.25rem; font-weight: 400; line-height: 1.4; margin: 0 0 15px 0; }
    #anspruch .pillar-desc { color: rgba(243, 231, 207, 0.65); font-size: 14.5px; line-height: 1.7; margin: 0; transition: color 0.3s ease; }
    #anspruch .pillar-card:hover .pillar-desc { color: rgba(243, 231, 207, 0.85); }
  </style>

  <div class="wrap">
    <!-- Kopf -->
    <div style="max-width: 720px; margin-bottom: 64px;">
      <div class="eyebrow-mini" style="color: var(--gold); letter-spacing: 0.15em; font-size: 0.85rem;">{{ i18n["pillars.eyebrow"][lang] }}</div>
      <h2 class="title-xl" style="margin-top: 15px; font-family: var(--font-display); font-weight: 400;"><span class="gold-grad">{{ i18n["nav.anspruch"][lang] }}</span></h2>
      <div style="margin-top: 25px; font-size: 18px; line-height: 1.75; color: rgba(243, 231, 207, 0.85);"><p>{{ i18n["pillars.text"][lang] }}</p></div>
    </div>

    <!-- Die sieben Grundsätze (I–VII) -->
    <div class="pillars-grid">
      {% for pillar in i18n.pillarsItems %}
        <div class="pillar-card">
          <div class="pillar-num">{{ pillar.num }}</div>
          <h3 class="pillar-title">{{ pillar.title[lang] }}</h3>
          <p class="pillar-desc">{{ pillar.desc[lang] }}</p>
        </div>
      {% endfor %}
    </div>

    <div class="rule-gold" style="margin: 20px auto 64px auto; max-width: 400px; height: 1px; background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.3), transparent);"></div>

    <!-- Leitbild / Fließtext (aus der früheren #mission-Sektion) -->
    <div class="imprint-grid">
      <div>
        <div class="eyebrow-mini">{{ i18n["about.eyebrow"][lang] }}</div>
        <h2 class="title-xl"><span class="gold-grad">{{ i18n["about.title"][lang] }}</span><br/><span class="nostyle"></span></h2>
      </div>
      <div>
      {{ i18n["about.text2"][lang] }}
      <br/><br/>
      {{ i18n["about.text3"][lang] }}
      <br/><br/>
      {{ i18n["about.text4"][lang] }}
      <br/><br/>
      {{ i18n["about.text5"][lang] }}
        <p class="sig">— {{ i18n["about.signature"][lang] }}</p>
      </div>
    </div>

    <div style="text-align: center; max-width: 600px; margin: 56px auto 0;">
      <p class="closing-statement" style="font-family: var(--font-display); font-size: 1.25rem; color: #f3e7cf; font-style: italic; letter-spacing: 0.02em; line-height: 1.6;">{{ i18n["pillars.closing"][lang] }}</p>
    </div>
  </div>
</section>

<!--TECHNIK (frühere Übersetzungs-Sektion)-->
<section id="technik" class="block imprint">
  <div class="paper-grain" style="position:absolute;inset:0;opacity:.3;pointer-events:none;"></div>
  <div class="wrap imprint-grid">
    <div>
      <div class="eyebrow-mini">{{ i18n["translation.eyebrow"][lang] }}</div>
      <h2 class="title-xl"><span class="gold-grad">{{ i18n["translation.title"][lang] }}</span><br/><span class="nostyle"></span></h2>
    </div>
    <div>
      <p>{{ i18n["translation.text1"][lang] }}
        <br/><br/>
        {{ i18n["translation.text2"][lang] }}
        <br/><br/>
        {{ i18n["translation.text3"][lang] }}
        <br/><br/>
        {{ i18n["translation.text4"][lang] }}
      </p>
      <p class="sig">— {{ i18n["translation.promise"][lang] }}</p>
          <div class="header-actions">
          <a href="#anspruch" class="btn-ghost">{{ i18n["translation.button"][lang] }}</a>
        </div>
    </div>
  </div>
</section>

<!--REIHEN (fünf Säulen; frühere #series-Sektion)-->
<section id="reihen" class="block" style="background-color: #161311; position: relative;">
  <div class="paper-grain" style="position:absolute;inset:0;opacity:.15;pointer-events:none;"></div>
  <div class="wrap">
    <div style="max-width: 720px; margin-bottom: 60px;">
      <div class="eyebrow-mini" style="color: var(--gold); letter-spacing: 0.15em; font-size: 0.85rem;">{{ i18n["series.eyebrow"][lang] }}</div>
      <h2 class="title-xl" style="margin-top: 15px; font-family: var(--font-display); font-weight: 400;"><span class="gold-grad">{{ i18n["series.title"][lang] }}</span></h2>
      <div style="margin-top: 25px; font-size: 17px; line-height: 1.7; color: rgba(243, 231, 207, 0.75);"><p>{{ i18n["series.intro"][lang] }}</p></div>
    </div>

    <div class="catalog-grid">
      {% for card in i18n.seriesItems %}
        <div class="series-card" style="border: 1px solid rgba(212, 175, 55, 0.12); padding: 35px; background-color: #181512; box-shadow: 0 12px 35px rgba(0,0,0,0.35); position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between;">
          <div style="position: absolute; top: 0; left: 0; right: 0; height: 3px; background-color: {{ card.colorHex }};"></div>
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; letter-spacing: 0.1em; color: rgba(243, 231, 207, 0.4); text-transform: uppercase; margin-bottom: 20px;">
              <span>{{ card.num }}</span>
              <span style="display: flex; align-items: center; gap: 8px;">
                <span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background-color: {{ card.colorHex }};"></span>
                {{ card.colorName[lang] }}
              </span>
            </div>
            <h3 style="color: #f3e7cf; font-family: var(--font-display); font-size: 1.35rem; margin-bottom: 15px; font-weight: 400; line-height: 1.4;">{{ card.label[lang] }}</h3>
            <p style="color: rgba(243, 231, 207, 0.7); font-size: 15px; line-height: 1.65; margin-bottom: 20px;">{{ card.desc[lang] }}</p>
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

<!--SETON-EDITION (Band I + II, bereits erschienen)-->
<section id="seton-edition" class="block" style="background-color: #161311; padding: 96px 0; position: relative; border-top: 1px solid rgba(212, 175, 55, 0.15);">
  <div class="paper-grain" style="position:absolute;inset:0;opacity:.12;pointer-events:none;"></div>
  <style>
    #seton-edition .seton-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 32px; }
    #seton-edition .seton-card { display: flex; gap: 20px; border: 1px solid rgba(212, 175, 55, 0.12); background-color: #181512; padding: 24px; box-shadow: 0 12px 35px rgba(0,0,0,0.35); min-width: 0; }
    #seton-edition .seton-cover { width: 140px; height: 210px; object-fit: cover; flex-shrink: 0; box-shadow: 0 8px 24px rgba(0,0,0,0.45); }
    @media (max-width: 480px) {
      #seton-edition .seton-card { flex-direction: column; }
      #seton-edition .seton-cover { width: 120px; height: 180px; }
    }
  </style>

  <div class="wrap">
    <div style="max-width: 720px; margin-bottom: 56px;">
      <div class="eyebrow-mini" style="color: var(--gold); letter-spacing: 0.15em; font-size: 0.85rem;">{{ i18n["seton.eyebrow"][lang] }}</div>
      <h2 class="title-xl" style="margin-top: 15px; font-family: var(--font-display); font-weight: 400;"><span class="gold-grad">{{ i18n["seton.title"][lang] }}</span></h2>
      <div style="margin-top: 25px; font-size: 17px; line-height: 1.7; color: rgba(243, 231, 207, 0.75);"><p>{{ i18n["seton.intro"][lang] }}</p></div>
    </div>

    <div class="seton-grid">
      {% for book in i18n.setonBooks %}
        <div class="seton-card">
          <picture style="display:contents">
            <source type="image/avif" srcset="/assets/images/{{ book.cover }}.avif" />
            <source type="image/webp" srcset="/assets/images/{{ book.cover }}.webp" />
            <img class="seton-cover" src="/assets/images/{{ book.cover }}-fallback.jpg" alt="{{ book.title[lang] }}" width="1024" height="1536" loading="lazy" decoding="async" />
          </picture>
          <div style="min-width: 0;">
            <div style="font-size: 0.75rem; letter-spacing: 0.1em; color: rgba(243, 231, 207, 0.4); text-transform: uppercase; margin-bottom: 10px;">{{ i18n["seton.volume"][lang] }} {{ book.band }} · {{ book.originalTitle }}</div>
            <h3 style="color: #f3e7cf; font-family: var(--font-display); font-size: 1.3rem; font-weight: 400; margin-bottom: 12px; line-height: 1.35;">{{ book.title[lang] }}</h3>
            <p style="color: rgba(243, 231, 207, 0.7); font-size: 14.5px; line-height: 1.6; margin-bottom: 16px;">{{ book.desc[lang] }}</p>
            <div style="font-size: 12px; color: rgba(243, 231, 207, 0.4); margin-bottom: 16px;">ISBN {{ book.isbn }}</div>
            <a href="{{ book.amazonUrl }}" target="_blank" rel="noopener" class="btn-press" style="font-size: 13px;">{{ i18n["seton.button"][lang] }} <span style="margin-left: 6px;">→</span></a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!--PRESSE (kompaktes Band; Vollinhalt auf /en/press/)-->
<section id="press-section" class="block" style="background-color: #161311; padding: 72px 0; position: relative; border-top: 1px solid rgba(212, 175, 55, 0.15);">
  <div class="paper-grain" style="position:absolute;inset:0;opacity:.12;pointer-events:none;"></div>
  <div class="wrap" style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 28px;">
    <div style="max-width: 560px;">
      <p class="eyebrow-mini" style="color: var(--gold); letter-spacing: 0.15em; font-size: 0.85rem; margin-bottom: 12px;">✦ {{ i18n["press.eyebrow"][lang] }}</p>
      <p style="font-family: var(--font-display); font-size: 1.4rem; color: #f3e7cf; line-height: 1.45; margin: 0;">{{ i18n["press.title"][lang] }}</p>
    </div>
    <div style="display: flex; gap: 24px; flex-wrap: wrap; align-items: center;">
      <a href="mailto:kontakt@aeternus-verlag.de" class="btn-press">{{ i18n["press.button"][lang] }} <span style="margin-left: 6px;">→</span></a>
      <a href="{% if lang == 'de' %}/presse/{% else %}/en/press/{% endif %}" style="font-family: var(--font-serif); font-size: 1rem; color: var(--gold); border-bottom: 1px solid rgba(212, 175, 55, 0.4); text-decoration: none; padding-bottom: 2px;">{{ i18n["press.more"][lang] }} →</a>
    </div>
  </div>
</section>

</main>
