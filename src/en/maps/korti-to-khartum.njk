  <script>
  (function(){
    var stage=document.getElementById('stage'), svg=null, vb=null, full=null;
    function apply(){ svg.setAttribute('viewBox', vb.join(' ')); }
    function clamp(){
      var w=Math.min(Math.max(vb[2], full[2]/14), full[2]*1.05), h=w*vb[3]/vb[2];
      vb[2]=w; vb[3]=h;
      vb[0]=Math.min(Math.max(vb[0], -w*0.25), full[2]-w*0.75);
      vb[1]=Math.min(Math.max(vb[1], -h*0.25), full[3]-h*0.75);
    }
    function fit(){
      var r=stage.getBoundingClientRect(), a=r.width/r.height, fa=full[2]/full[3];
      if(a>fa){ var w=full[3]*a; vb=[(full[2]-w)/2,0,w,full[3]]; } else { var h=full[2]/a; vb=[0,(full[3]-h)/2,full[2],h]; }
      apply();
    }
    function zoom(f,cx,cy){
      var r=stage.getBoundingClientRect();
      if(cx===undefined){ cx=r.left+r.width/2; cy=r.top+r.height/2; }
      var px=vb[0]+(cx-r.left)/r.width*vb[2], py=vb[1]+(cy-r.top)/r.height*vb[3];
      var w=vb[2]/f, h=vb[3]/f;
      vb=[px-(cx-r.left)/r.width*w, py-(cy-r.top)/r.height*h, w, h]; clamp(); apply();
    }
    fetch('/assets/maps/korti-to-khartum/korti-to-khartum-map.svg').then(function(r){return r.text();}).then(function(t){
      document.getElementById('loading').remove();
      stage.insertAdjacentHTML('beforeend', t);
      svg=stage.querySelector('svg');
      svg.removeAttribute('width'); svg.removeAttribute('height');
      svg.setAttribute('preserveAspectRatio','xMidYMid meet');
      full=svg.getAttribute('viewBox').split(/[ ,]+/).map(Number);
      fit();
      stage.addEventListener('wheel',function(e){ e.preventDefault(); zoom(e.deltaY<0?1.25:0.8,e.clientX,e.clientY); },{passive:false});
      var pts={}, last=null, lastDist=null;
      stage.addEventListener('pointerdown',function(e){ if(e.target.closest('.tools')) return; stage.setPointerCapture(e.pointerId); pts[e.pointerId]={x:e.clientX,y:e.clientY}; stage.classList.add('dragging'); });
      stage.addEventListener('pointermove',function(e){
        if(!pts[e.pointerId]) return;
        var r=stage.getBoundingClientRect(), p=pts[e.pointerId], ids=Object.keys(pts);
        if(ids.length===1){
          vb[0]-= (e.clientX-p.x)/r.width*vb[2]; vb[1]-= (e.clientY-p.y)/r.height*vb[3]; clamp(); apply();
        } else if(ids.length===2){
          pts[e.pointerId]={x:e.clientX,y:e.clientY};
          var a=pts[ids[0]], b=pts[ids[1]], d=Math.hypot(a.x-b.x,a.y-b.y);
          if(lastDist) zoom(d/lastDist,(a.x+b.x)/2,(a.y+b.y)/2);
          lastDist=d; return;
        }
        pts[e.pointerId]={x:e.clientX,y:e.clientY};
      });
      function up(e){ delete pts[e.pointerId]; lastDist=null; if(!Object.keys(pts).length) stage.classList.remove('dragging'); }
      stage.addEventListener('pointerup',up); stage.addEventListener('pointercancel',up);
      document.getElementById('zin').onclick=function(){zoom(1.5);};
      document.getElementById('zout').onclick=function(){zoom(1/1.5);};
      document.getElementById('zreset').onclick=fit;
      window.addEventListener('resize',fit);
    }).catch(function(){ document.getElementById('loading').textContent='The map could not be loaded — please use the PDF below.'; });
  })();
  </script>
