---
title: "AETERNUS VERLAG · Editionshaus für historische Texte & Klassiker"
layout: base.njk
lang: de
permalink: /index.html
hreflang: true
---

<main>

<!--HERO SECTION-->
<section class="hero">
  <picture style="display:contents">
    <source type="image/avif" srcset="/assets/images/hero-library.avif" />
    <source type="image/webp" srcset="/assets/images/hero-library.webp" />
    <img class="hero-bg" src="/assets/images/hero-library.jpg" alt="Antique books, military map, brass compass and candle on a mahogany desk" width="1920" height="1080" fetchpriority="high" decoding="async" />
  </picture>
  <div class="hero-veil"></div>
  <div class="hero-vignette vignette"></div>
  <div class="hero-grain paper-grain"></div>
  <div class="wrap hero-inner">
    <div>
      <div class="eyebrow imperial"><span class="line"></span><span>{{ i18n["hero.top-title"][lang] }}</span></div>
      <h1 class="headline">
        <span class="l1 gold-grad">{{ i18n["hero.title"][lang] }} </span>
        <span class="l2"></span>
        <span class="l3"></span>
      </h1>
      <p class="lede">{{ i18n["hero.subtitle"][lang] }}</p>
      <div class="cta-row">
        <a href="#reihen" class="btn btn-primary">{{ i18n["hero.btn1"][lang] }}<span class="ar">→</span></a>
        <a href="#anspruch" class="btn-link">{{ i18n["hero.btn2"][lang] }}</a>
      </div>
    </div>
    <div class="metrics">
      <div class="metric">
      <div class="n">2026</div>
      <div class="l">{{ i18n["metrics.info1.1st"][lang] }}</div>
      </div>
      <div class="metric">
      <div class="n">{{ i18n["metrics.info2.1st"][lang] }}</div>
      <div class="l">{{ i18n["metrics.info2.2nd"][lang] }}</div>
      </div>
      <div class="metric">
      <div class="n">{{ i18n["metrics.info3.1st"][lang] }}</div>
      <div class="l">{{ i18n["metrics.info3.2nd"][lang] }}</div>
      </div>
      <div class="metric">
      <div class="n">{{ i18n["metrics.info4.1st"][lang] }}</div>
      <div class="l">{{ i18n["metrics.info4.2nd"][lang] }}</div>
      </div>
       <div class="metric">
      <div class="n">{{ i18n["metrics.info5.1st"][lang] }}</div>
      <div class="l">{{ i18n["metrics.info5.2nd"][lang] }}</div>
      </div>
    </div>
  </div>
</section>

<!--AKTUELLE AUSGABEN: datengetrieben aus seriesItems[].authors[].books — kein Autor wird hier besonders hervorgehoben,
    die Karten erscheinen schlicht in Reihenfolge des Programms. Neue Titel/Autoren erscheinen hier automatisch. -->
<section id="aktuelle-ausgaben" class="block" style="background-color: #161311; padding: 96px 0; position: relative; border-top: 1px solid rgba(212, 175, 55, 0.15);">
  <div class="paper-grain" style="position:absolute;inset:0;opacity:.12;pointer-events:none;"></div>
  <style>
    #aktuelle-ausgaben .edition-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 32px; }
    #aktuelle-ausgaben .edition-card { display: flex; gap: 20px; border: 1px solid rgba(212, 175, 55, 0.12); background-color: #181512; padding: 24px; box-shadow: 0 12px 35px rgba(0,0,0,0.35); min-width: 0; }
    #aktuelle-ausgaben .edition-cover { width: 140px; height: 210px; object-fit: cover; flex-shrink: 0; box-shadow: 0 8px 24px rgba(0,0,0,0.45); }
    @media (max-width: 480px) {
      #aktuelle-ausgaben .edition-card { flex-direction: column; }
      #aktuelle-ausgaben .edition-cover { width: 120px; height: 180px; }
    }
  </style>

  <div class="wrap">
    <div style="max-width: 720px; margin-bottom: 56px;">
      <div class="eyebrow-mini" style="color: var(--gold); letter-spacing: 0.15em; font-size: 0.85rem;">{{ i18n["editions.eyebrow"][lang] }}</div>
      <h2 class="title-xl" style="margin-top: 15px; font-family: var(--font-display); font-weight: 400;"><span class="gold-grad">{{ i18n["editions.title"][lang] }}</span></h2>
      <div style="margin-top: 25px; font-size: 17px; line-height: 1.7; color: rgba(243, 231, 207, 0.75);"><p>{{ i18n["editions.intro"][lang] }}</p></div>
    </div>

    <div class="edition-grid">
      {% for series in i18n.seriesItems %}
        {% for author in series.authors %}
          {% for book in author.books %}
            <div class="edition-card">
              <picture style="display:contents">
                <source type="image/avif" srcset="/assets/images/{{ book.cover }}.avif" />
                <source type="image/webp" srcset="/assets/images/{{ book.cover }}.webp" />
                <img class="edition-cover" src="/assets/images/{{ book.cover }}-fallback.jpg" alt="{{ book.title[lang] }}" width="1024" height="1536" loading="lazy" decoding="async" />
              </picture>
              <div style="min-width: 0;">
                <div style="font-size: 0.75rem; letter-spacing: 0.1em; color: rgba(243, 231, 207, 0.4); text-transform: uppercase; margin-bottom: 10px;">{{ author.name }} · {{ series.colorName[lang] }}</div>
                <h3 style="color: #f3e7cf; font-family: var(--font-display); font-size: 1.3rem; font-weight: 400; margin-bottom: 12px; line-height: 1.35;">{{ book.title[lang] }}</h3>
                <p style="color: rgba(243, 231, 207, 0.7); font-size: 14.5px; line-height: 1.6; margin-bottom: 16px;">{{ book.desc[lang] }}</p>
                <div style="font-size: 12px; color: rgba(243, 231, 207, 0.4); margin-bottom: 16px;">ISBN {{ book.isbn }}</div>
                <a href="{{ book.amazonUrl }}" target="_blank" rel="noopener" class="btn-ghost" style="font-size: 11px; padding: 12px 22px;">{{ i18n["seton.button"][lang] }}</a>
              </div>
            </div>
          {% endfor %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

<!--ANSPRUCH: gekürzte Fassung — volle Fassung (7 Grundsätze + Leitbild) lebt auf /verlag/-->
<section id="anspruch" class="block" style="background-color: #161311; position: relative; border-top: 1px solid rgba(212, 175, 55, 0.15);">
  <div class="paper-grain" style="position:absolute;inset:0;opacity:.15;pointer-events:none;"></div>
  <div class="wrap">
    <div style="max-width: 720px;">
      <div class="eyebrow-mini" style="color: var(--gold); letter-spacing: 0.15em; font-size: 0.85rem;">{{ i18n["about.eyebrow"][lang] }}</div>
      <h2 class="title-xl" style="margin-top: 15px; font-family: var(--font-display); font-weight: 400;"><span class="gold-grad">{{ i18n["nav.anspruch"][lang] }}</span></h2>
      <div style="margin-top: 25px; font-size: 18px; line-height: 1.75; color: rgba(243, 231, 207, 0.85);"><p>{{ i18n["pillars.text"][lang] }}</p></div>
    </div>

    <div style="margin-top: 48px; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 24px; max-width: 1000px;">
      {% for pillar in i18n.pillarsItems %}
        {% if loop.index <= 3 %}
          <div style="border-left: 2px solid rgba(212, 175, 55, 0.3); padding-left: 16px;">
            <div style="font-size: 0.72rem; color: rgba(243, 231, 207, 0.4); letter-spacing: 0.1em; margin-bottom: 6px;">{{ pillar.num }}</div>
            <div style="font-family: var(--font-display); font-size: 1rem; color: #f3e7cf;">{{ pillar.title[lang] }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div style="margin-top: 48px;">
      <a href="{% if lang == 'de' %}/verlag/{% else %}/en/house/{% endif %}" class="btn-link">{{ i18n["verlag.more"][lang] }} →</a>
    </div>
  </div>
</section>

<!--REIHEN: kompakte visuelle Übersicht — volle Fassung (mit Autoren/Titeln je Reihe) lebt auf /reihen/-->
<section id="reihen" class="block" style="background-color: #161311; position: relative;">
  <div class="paper-grain" style="position:absolute;inset:0;opacity:.15;pointer-events:none;"></div>
  <div class="wrap">
    <div style="max-width: 720px; margin-bottom: 60px;">
      <div class="eyebrow-mini" style="color: var(--gold); letter-spacing: 0.15em; font-size: 0.85rem;">{{ i18n["series.eyebrow"][lang] }}</div>
      <h2 class="title-xl" style="margin-top: 15px; font-family: var(--font-display); font-weight: 400;"><span class="gold-grad">{{ i18n["series.title"][lang] }}</span></h2>
      <div style="margin-top: 25px; font-size: 17px; line-height: 1.7; color: rgba(243, 231, 207, 0.75);"><p>{{ i18n["series.intro"][lang] }}</p></div>
    </div>

    <div class="catalog-grid">
      {% for card in i18n.seriesItems %}
        <div class="series-card" style="border: 1px solid rgba(212, 175, 55, 0.12); padding: 35px; background-color: #181512; box-shadow: 0 12px 35px rgba(0,0,0,0.35); position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between;">
          <div style="position: absolute; top: 0; left: 0; right: 0; height: 3px; background-color: {{ card.colorHex }};"></div>
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; letter-spacing: 0.1em; color: rgba(243, 231, 207, 0.4); text-transform: uppercase; margin-bottom: 20px;">
              <span>{{ card.num }}</span>
              <span style="display: flex; align-items: center; gap: 8px;">
                <span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background-color: {{ card.colorHex }};"></span>
                {{ card.colorName[lang] }}
              </span>
            </div>
            <h3 style="color: #f3e7cf; font-family: var(--font-display); font-size: 1.35rem; margin-bottom: 15px; font-weight: 400; line-height: 1.4;">{{ card.label[lang] }}</h3>
            <p style="color: rgba(243, 231, 207, 0.7); font-size: 15px; line-height: 1.65; margin-bottom: 0;">{{ card.desc[lang] }}</p>
          </div>
        </div>
      {% endfor %}
    </div>

    <div style="margin-top: 48px; text-align: center;">
      <a href="{% if lang == 'de' %}/reihen/{% else %}/en/series/{% endif %}" class="btn-link">{{ i18n["reihen.more"][lang] }} →</a>
    </div>
  </div>
</section>

<!--EDITION: gekürzte Fassung — volle Fassung lebt auf /edition/-->
<section id="edition" class="block imprint">
  <div class="paper-grain" style="position:absolute;inset:0;opacity:.3;pointer-events:none;"></div>
  <div class="wrap imprint-grid">
    <div>
      <div class="eyebrow-mini">{{ i18n["translation.eyebrow"][lang] }}</div>
      <h2 class="title-xl"><span class="gold-grad">{{ i18n["translation.title"][lang] }}</span></h2>
    </div>
    <div>
      <p>{{ i18n["translation.text1"][lang] }}</p>
      <p class="sig">— {{ i18n["translation.promise"][lang] }}</p>
      <div class="header-actions">
        <a href="{% if lang == 'de' %}/edition/{% else %}/en/edition/{% endif %}" class="btn-ghost">{{ i18n["edition.more"][lang] }}</a>
      </div>
    </div>
  </div>
</section>

<!--AUTOREN IM PROGRAMM: datengetrieben aus seriesItems[].authors[] — verweist auf /reihen/#slug (volles Profil je Reihe)
    und auf #aktuelle-ausgaben (Titel direkt auf dieser Seite). Wächst automatisch mit jedem neuen Autor. -->
<section id="autoren" class="block" style="background-color: #161311; position: relative; border-top: 1px solid rgba(212, 175, 55, 0.15);">
  <div class="paper-grain" style="position:absolute;inset:0;opacity:.12;pointer-events:none;"></div>
  <style>
    #autoren .authors-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 28px; margin-top: 48px; }
    #autoren .author-card { border: 1px solid rgba(212, 175, 55, 0.12); background-color: #181512; padding: 28px; }
    #autoren .author-card .badge { font-size: 0.72rem; letter-spacing: 0.1em; color: rgba(243, 231, 207, 0.4); text-transform: uppercase; margin-bottom: 12px; }
    #autoren .author-card h3 { font-family: var(--font-display); font-size: 1.2rem; font-weight: 400; margin-bottom: 14px; }
    #autoren .author-card h3 a { color: #f3e7cf; transition: color .3s; }
    #autoren .author-card h3 a:hover { color: var(--gold); }
    #autoren .author-card .view { font-family: var(--font-sans); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold); }
  </style>
  <div class="wrap">
    <div style="max-width: 720px;">
      <div class="eyebrow-mini" style="color: var(--gold); letter-spacing: 0.15em; font-size: 0.85rem;">{{ i18n["authors.eyebrow"][lang] }}</div>
      <h2 class="title-xl" style="margin-top: 15px; font-family: var(--font-display); font-weight: 400;"><span class="gold-grad">{{ i18n["authors.title"][lang] }}</span></h2>
      <div style="margin-top: 25px; font-size: 17px; line-height: 1.7; color: rgba(243, 231, 207, 0.75);"><p>{{ i18n["authors.intro"][lang] }}</p></div>
    </div>

    <div class="authors-grid">
      {% for series in i18n.seriesItems %}
        {% for author in series.authors %}
          <div class="author-card">
            <div class="badge">{{ series.colorName[lang] }} · {{ i18n["nav.series"][lang] }} {{ series.num }}</div>
            <h3><a href="{% if lang == 'de' %}/reihen/{% else %}/en/series/{% endif %}#{{ author.slug }}">{{ author.name }}</a></h3>
            <a class="view" href="#aktuelle-ausgaben">{{ i18n["authors.viewTitles"][lang] }} →</a>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

<!--PRESSE + LESERAUM (kompaktes Band; Vollinhalt auf /presse/)-->
<section id="press-section" class="block" style="background-color: #161311; padding: 72px 0; position: relative; border-top: 1px solid rgba(212, 175, 55, 0.15);">
  <div class="paper-grain" style="position:absolute;inset:0;opacity:.12;pointer-events:none;"></div>
  <div class="wrap" style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 28px;">
    <div style="max-width: 560px;">
      <p class="eyebrow-mini" style="color: var(--gold); letter-spacing: 0.15em; font-size: 0.85rem; margin-bottom: 12px;">✦ {{ i18n["press.eyebrow"][lang] }}</p>
      <p style="font-family: var(--font-display); font-size: 1.4rem; color: #f3e7cf; line-height: 1.45; margin: 0;">{{ i18n["press.title"][lang] }}</p>
    </div>
    <div style="display: flex; gap: 24px; flex-wrap: wrap; align-items: center;">
      <a href="mailto:kontakt@aeternus-verlag.de" class="btn-press">{{ i18n["press.button"][lang] }} <span style="margin-left: 6px;">→</span></a>
      <a href="{% if lang == 'de' %}/presse/{% else %}/en/press/{% endif %}" style="font-family: var(--font-serif); font-size: 1rem; color: var(--gold); border-bottom: 1px solid rgba(212, 175, 55, 0.4); text-decoration: none; padding-bottom: 2px;">{{ i18n["press.more"][lang] }} →</a>
      <a href="#aktuelle-ausgaben" style="font-family: var(--font-serif); font-size: 1rem; color: var(--gold); border-bottom: 1px solid rgba(212, 175, 55, 0.4); text-decoration: none; padding-bottom: 2px;">{{ i18n["nav.readingroom"][lang] }} →</a>
    </div>
  </div>
</section>

</main>
