---
permalink: /kosmos/index.html
lang: de
title: "Das Universum der Bücher · AETERNUS"
description: "Entdecken Sie den literarischen Kosmos von AETERNUS: Bücher, Schauplätze und ihre inhaltlichen Verbindungen auf einer interaktiven Weltkarte."
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="theme-color" content="#10100f">
  <link rel="canonical" href="https://aeternus-verlag.de/kosmos/">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="https://aeternus-verlag.de/kosmos/">
  <meta property="og:image" content="https://aeternus-verlag.de/assets/images/hero-library.jpg">
  <meta property="og:site_name" content="AETERNUS Verlag">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/css/kosmos.css?v={{ kosmos.cssVersion }}">
</head>
<body>
  <a class="atlas-home" href="/">← Zum Verlag</a>
  <a class="atlas-catalogue" href="/buecher/">Alle Bücher ↗</a>
  <main id="main" aria-labelledby="title">
    <header>
      <p class="eyebrow">AETERNUS · LITERARISCHER ATLAS</p>
      <h1 id="title">Das Universum der Bücher</h1>
      <p><a href="/kosmos/netzwerk/" style="color:inherit">Bücher &amp; Themen als Netzwerk entdecken →</a></p><p class="hint">Buch berühren · Verbindungen erkunden · Anklicken und eintreten</p>
    </header>

    <button class="reset-focus" id="reset-focus" type="button" hidden>← Zur Übersicht <span>Esc</span></button>

    <svg id="graph" role="group" aria-label="Weltkarte mit geografisch verorteten und verwandten Büchern"></svg>
    <p class="cosmos-stats" id="cosmos-stats"></p>

    <nav aria-label="Kontinent wählen">
      <button type="button" data-region="world" aria-pressed="true">Welt</button>
      <button type="button" data-region="north-america" aria-pressed="false">Nordamerika</button>
      <button type="button" data-region="europe" aria-pressed="false">Europa</button>
      <button type="button" data-region="africa" aria-pressed="false">Afrika</button>
      <button type="button" data-region="asia" aria-pressed="false">Asien</button>
    </nav>

    <p class="fallback" id="fallback" hidden>Die Kartenansicht konnte nicht geladen werden.</p>
  </main>

  <button class="panel-backdrop" type="button" tabindex="-1" aria-hidden="true" aria-label="Buchfenster schließen" data-close-panel></button>
  <section class="book-panel" id="book-panel" role="dialog" aria-modal="true" aria-labelledby="panel-title" aria-hidden="true" inert>
    <button class="panel-close" type="button" aria-label="Buchfenster schließen" data-close-panel>×</button>
    <div class="panel-hero">
      <div class="panel-cover-shell"><img class="panel-cover" id="panel-cover" alt=""></div>
      <div>
        <p class="panel-kicker" id="panel-kicker"></p>
        <h2 class="panel-title" id="panel-title"></h2>
        <p class="panel-author" id="panel-author"></p>
      </div>
    </div>
    <div class="panel-meta" id="panel-meta"></div>
    <p class="panel-subtitle" id="panel-subtitle"></p>
    <p class="panel-summary" id="panel-summary"></p>
    <section class="relation-section" aria-labelledby="relation-title">
      <div class="relation-heading">
        <h3 id="relation-title">Verwandte Werke</h3>
        <span id="relation-count"></span>
      </div>
      <div class="related-list" id="related-list"></div>
    </section>
    <div class="panel-actions">
      <a class="panel-action" id="landing-link" href="#" target="_blank" rel="noopener noreferrer">Zur Verlagsseite ↗</a>
      <a class="panel-action secondary" id="amazon-link" href="#" target="_blank" rel="noopener noreferrer">Bei Amazon ansehen ↗</a>
    </div>
  </section>


  <noscript><div class="atlas-noscript">Für die interaktive Weltkarte benötigen Sie JavaScript. <a href="/buecher/">Hier finden Sie unseren Buchkatalog.</a></div></noscript>
  <script type="application/json" id="kosmos-data">{{ kosmos.payload | safe }}</script>
  <script src="/assets/vendor/d3-7.9.0.min.js" defer></script>
  <script src="/assets/vendor/topojson-client-3.1.0.min.js" defer></script>
  <script src="/assets/js/kosmos.js?v={{ kosmos.jsVersion }}" defer></script>
</body>
</html>
