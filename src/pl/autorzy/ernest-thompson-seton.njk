  <script>
    const books = [
      {
        title: "Dzikie zwierzęta, które znałem",
        subtitle: "Osiem opowieści o zwierzętach z północnoamerykańskiej dziczy",
        metadata: "Aeternus Verlag · Seria Bursztynowa · oprawa twarda i Kindle",
        summary: "Od wilczego króla Lobo po kruka Silverspota: najsłynniejszy tom Setona łączy precyzyjną obserwację przyrody z dramatyczną sztuką opowiadania.",
        sample: "Lobo włada doliną Currumpaw nie jak postać z bajki, lecz dzięki doświadczeniu, ostrożności i więzi ze swoim stadem.",
        amazon: "https://www.amazon.de/dp/3912883009"
      },
      {
        title: "Wahb. Biografia niedźwiedzia grizzly",
        subtitle: "Życie zwierzęcia bez sentymentalizmu",
        metadata: "Aeternus Verlag · Seria Bursztynowa · oprawa twarda i Kindle",
        summary: "Historia życia grizzly Wahba — od młodości po starość — opowiedziana surowo, precyzyjnie i z niezwykłą bliskością dzikiej przyrody.",
        sample: "Świat Wahba składa się z zapachów, pamięci i terenu. Każdy trop zmienia niewidzialną mapę, według której żyje.",
        amazon: "https://www.amazon.de/dp/3912883017"
      },
      {
        title: "Arktyczne prerie",
        subtitle: "Dwa tysiące mil kajakiem w poszukiwaniu karibu",
        metadata: "Relacja z wyprawy · północna Kanada · 1911",
        summary: "Sześciomiesięczna podróż Setona na kanadyjską Północ łączy dziennik terenowy, obserwacje zwierząt, kartografię i spotkania na dawnych szlakach handlowych.",
        sample: "Za ostatnimi faktorami otwiera się kraina, w której odległość znów mierzy się tygodniami, zmianami pogody i zakolami rzek.",
        amazon: "https://www.amazon.pl/s?k=Ernest+Thompson+Seton+Arktyczne+prerie"
      },
      {
        title: "Księga puszczaństwa i wiedzy indiańskiej",
        subtitle: "Przyrodoznawstwo, życie obozowe i kształtowanie charakteru",
        metadata: "Podręcznik · ponad 500 ilustracji · 1912",
        summary: "Encyklopedyczny przewodnik po tropieniu, budowie obozu, orientacji, historii naturalnej i wspólnotowej edukacji w plenerze.",
        sample: "Dla Setona puszczaństwo nie zaczyna się od narzędzia, lecz od uwagi: najpierw nauczyć się obserwować, dopiero potem działać.",
        amazon: "https://www.amazon.pl/s?k=Ernest+Thompson+Seton+Book+of+Woodcraft"
      }
    ];

    const modal = document.getElementById("book-modal");
    const modalTitle = document.getElementById("modal-title");
    const modalSubtitle = document.getElementById("modal-subtitle");
    const modalMetadata = document.getElementById("modal-metadata");
    const modalSummary = document.getElementById("modal-summary");
    const modalSample = document.getElementById("modal-sample");
    const modalAmazon = document.getElementById("modal-amazon");
    const modalMonogram = document.getElementById("modal-monogram");
    let lastTrigger = null;

    function openBook(index, trigger) {
      const book = books[index];
      if (!book) return;
      lastTrigger = trigger;
      modalTitle.textContent = book.title;
      modalSubtitle.textContent = book.subtitle;
      modalMetadata.textContent = book.metadata;
      modalSummary.textContent = book.summary;
      modalSample.textContent = book.sample;
      modalAmazon.href = book.amazon;
      modalMonogram.textContent = String(index + 1).padStart(2, "0");
      modal.classList.add("is-open");
      modal.setAttribute("aria-hidden", "false");
      document.body.classList.add("modal-open");
      modal.querySelector(".modal-close").focus();
    }

    function closeBook() {
      modal.classList.remove("is-open");
      modal.setAttribute("aria-hidden", "true");
      document.body.classList.remove("modal-open");
      if (lastTrigger) lastTrigger.focus();
    }

    document.querySelectorAll("[data-book]").forEach((button) => {
      button.addEventListener("click", () => openBook(Number(button.dataset.book), button));
    });

    document.querySelectorAll("[data-close-modal]").forEach((button) => {
      button.addEventListener("click", closeBook);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && modal.classList.contains("is-open")) closeBook();
      if (event.key !== "Tab" || !modal.classList.contains("is-open")) return;
      const focusable = Array.from(modal.querySelectorAll("button, a[href]"));
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  </script>
