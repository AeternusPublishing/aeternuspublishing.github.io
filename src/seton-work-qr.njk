---
pagination:
  data: setonWorkQr.works
  size: 1
  alias: work
permalink: "/qr/{{ work.id }}/index.html"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,follow">
  <title>{{ work.title }} · AETERNUS Verlag</title>
  <meta http-equiv="refresh" content="0;url={{ work.target }}">
  <link rel="canonical" href="https://aeternus-verlag.de{{ work.target }}">
  <script>
    const params = new URLSearchParams(window.location.search);
    if (!params.has("utm_source")) params.set("utm_source", "book_qr");
    if (!params.has("utm_medium")) params.set("utm_medium", "print");
    if (!params.has("utm_campaign")) params.set("utm_campaign", "{{ work.id }}");
    window.location.replace("{{ work.target }}?" + params.toString());
  </script>
</head>
<body><p><a href="{{ work.target }}">{{ work.title }}: Buch und Ausgaben öffnen</a></p></body>
</html>
